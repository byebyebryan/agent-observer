#!/usr/bin/env python3
"""Explicit native-isolation proof of blank rejection and persisted Resume.

Only bounded metadata is emitted. Empty stored-history response semantics are
covered by controlled tests; this native proof uses an ordinary blank context
and its initialized saved history without editing private provider stores.
"""

import json
import os
import runpy
import time
from pathlib import Path


def main():
    root = Path(os.environ["NATIVE_PROOF_ROOT"])
    Proof = runpy.run_path(str(root / "native-acceptance"))["Proof"]
    oracle = runpy.run_path(str(root / "evaluate-observation"))
    NativeRPC = oracle["NativeRPC"]
    proof = Proof("codex")
    peer = None
    receipt = {"hostScope": proof.host, "isolationEstablished": True,
               "ordinaryProviderActions": False, "rawPayloadsPersisted": False,
               "terminalOutputPersisted": False, "referenceImportsObserver": False}
    try:
        viewer = proof.spawn(proof.handoff())
        proof.pause(viewer, 5)
        proof.assert_native_client(viewer)
        peer = NativeRPC(proof.base / "codex")
        ids = peer.pages("thread/loaded/list")
        if len(ids) != 1:
            raise ValueError("fresh_native_fixture_required")
        sid = ids[0]
        summary = peer.call("thread/read", {"threadId": sid, "includeTurns": False})["thread"]
        row = next(r for r in proof.snapshot()["sessions"] if r["identity"]["nativeId"] == sid)
        ref = row["identity"]
        if row["runtime"]["value"] != "running" or row["hasSavedHistory"]:
            raise ValueError("blank_discovery_mismatch")
        before = set(peer.pages("thread/loaded/list"))
        try:
            proof.handoff(ref)
        except RuntimeError as error:
            if str(error) != "resume_saved_history_unproved":
                raise
        else:
            raise ValueError("blank_resume_was_prepared")
        if set(peer.pages("thread/loaded/list")) != before:
            raise ValueError("passive_prepare_changed_inventory")
        receipt["blank"] = {"nativeId": sid, "nativeStatus": summary["status"]["type"],
                            "ephemeral": summary["ephemeral"], "pathPresent": summary.get("path") is not None,
                            "hasSavedHistory": row["hasSavedHistory"],
                            "resumeRejected": "resume_saved_history_unproved", "loadedInventoryUnchanged": True}
        os.write(viewer[1], b"Reply only with OK.\r")
        proof.pause(viewer, 1)
        os.write(viewer[1], b"\r")
        deadline = time.monotonic() + 65
        while time.monotonic() < deadline:
            proof.pause(viewer, .3)
            try:
                turns = peer.call("thread/turns/list", {"threadId": sid, "limit": 1,
                                                       "sortDirection": "desc", "itemsView": "notLoaded"})["data"]
            except ValueError:
                continue
            if turns and turns[0].get("completedAt") is not None:
                break
        else:
            raise ValueError("native_turn_pending")
        turn = turns[0]
        if turn.get("items") != [] or turn.get("itemsView") != "notLoaded":
            raise ValueError("native_content_not_omitted")
        at = turn["completedAt"] * 1000
        row = proof.row(ref)
        if not row["hasSavedHistory"] or row["activity"]["at"] != at:
            raise ValueError("initialized_saved_evidence_mismatch")
        before = set(peer.pages("thread/loaded/list"))
        result = proof.handoff(ref)
        if result["effect"] != "none" or set(peer.pages("thread/loaded/list")) != before:
            raise ValueError("saved_prepare_changed_inventory")
        repeated = proof.spawn(result)
        proof.pause(repeated, 5)
        proof.assert_native_client(repeated)
        if proof.row(ref)["activity"]["at"] != at:
            raise ValueError("resume_changed_conversation_age")
        receipt["initialized"] = {"nativeId": sid, "nativeTurnId": turn["id"],
                                  "activityAt": at, "hasSavedHistory": True,
                                  "nativeResumeEntered": True, "ageUnchanged": True,
                                  "prepareEffect": "none", "loadedInventoryUnchanged": True}
        for client in list(proof.clients):
            proof.stop(client)
        receipt["provider"] = peer.artifact
        receipt["status"] = "accepted"
        (root / "saved-evidence.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        for client in list(proof.clients):
            proof.stop(client)
        if peer is not None:
            peer.close()


if __name__ == "__main__":
    main()
