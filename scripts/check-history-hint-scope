#!/usr/bin/env python3
"""Installed controlled publishers: nested noise versus primary history append.

Synthetic owned history only; no native session start, borrowed auth or hooks.
This is a filesystem/installed integration proof, not native workflow evidence.
"""

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import signal
import subprocess
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--before-prefix", type=Path, required=True)
    parser.add_argument("--after-prefix", type=Path, required=True)
    parser.add_argument("--root", type=Path, required=True)
    args = parser.parse_args()
    assert args.root.resolve(strict=True) == args.root and args.root.stat().st_uid == os.getuid()
    assert args.root.stat().st_mode & 0o077 == 0
    home = args.root / "history"
    home.mkdir(mode=0o700)
    for name in ("sessions", "jobs", "projects"):
        (home / name).mkdir(mode=0o700)
    project = home / "projects/project"
    project.mkdir(mode=0o700)
    sid = "01234567-0123-4567-89ab-0123456789ab"
    transcript = project / (sid + ".jsonl")

    def append(path):
        at = int(time.time() * 1000)
        event = {"sessionId": sid, "type": "user", "isSidechain": False,
                 "isMeta": False, "cwd": str(args.root),
                 "timestamp": datetime.fromtimestamp(at / 1000, timezone.utc).isoformat(),
                 "message": {"role": "user", "content": "bounded synthetic fixture"}}
        with path.open("a") as stream:
            stream.write(json.dumps(event) + "\n")
        return at

    activity = append(transcript)
    services, endpoints = {}, {}

    def frame(mode):
        prefix = args.before_prefix if mode == "before" else args.after_prefix
        value = subprocess.run([str(prefix / "bin/agent-observer"), "service", "snapshot",
                                "--host-scope", "scope-fixture", "--socket", str(endpoints[mode])],
                               capture_output=True, timeout=20)
        assert value.returncode == 0, "controlled_reader_failed"
        return json.loads(value.stdout)

    def history(value):
        return next(c for source in value["sources"] for c in source["components"] if c["name"] == "history")

    try:
        for mode, prefix in (("before", args.before_prefix), ("after", args.after_prefix)):
            endpoints[mode] = args.root / mode / "read.sock"
            assert len(os.fsencode(endpoints[mode])) <= 100
            services[mode] = subprocess.Popen(
                [str(prefix / "bin/agent-observer-service"), "serve", "--host-scope", "scope-fixture",
                 "--provider", "claude", "--claude-home", str(home), "--socket", str(endpoints[mode]),
                 "--runtime-interval", "30", "--history-interval", "120", "--native-hints"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            try:
                values = {mode: frame(mode) for mode in services}
                if all(history(v)["accepted"] and any(r["identity"]["nativeId"] == sid and r["activity"]["at"] == activity for r in (v["snapshot"] or {}).get("sessions", [])) for v in values.values()):
                    break
            except (AssertionError, OSError, ValueError):
                pass
            assert all(p.poll() is None for p in services.values()), "controlled_publisher_exited"
            time.sleep(.2)
        else:
            raise RuntimeError("controlled_history_warm_pending")
        time.sleep(12)  # Settle the bounded source-ready trailing history read.
        baseline = {mode: history(frame(mode))["accepted"] for mode in services}
        nested = project / (sid + "/subagents")
        nested.mkdir(parents=True)
        child = nested / "agent-fixture.jsonl"
        for _ in range(100):
            append(child)
            time.sleep(.04)
        time.sleep(12)
        counts = {mode: history(frame(mode))["accepted"] - baseline[mode] for mode in services}
        assert counts["before"] > 0 and counts["after"] == 0, "nested_history_wakeup_scope"
        primary = append(transcript)
        started, deadline = time.monotonic(), time.monotonic() + 20
        while time.monotonic() < deadline:
            current = frame("after")
            row = next(r for r in current["snapshot"]["sessions"] if r["identity"]["nativeId"] == sid)
            if row["activity"]["at"] == primary:
                break
            time.sleep(.1)
        else:
            raise RuntimeError("primary_history_wakeup_pending")
        delay = time.monotonic() - started
        assert delay <= 15
        receipt = {"status": "accepted", "evidenceClass": "installed_controlled_filesystem",
                   "prefixes": {"before": str(args.before_prefix), "after": str(args.after_prefix)},
                   "nestedWrites": 100, "additionalHistoryReads": counts,
                   "primaryAppendToCachedSeconds": delay,
                   "historyReconciliationSeconds": 120,
                   "ordinaryProviderActions": False, "borrowedAuthentication": False,
                   "nativeWorkflowClaimed": False, "rawHistoryArchived": False}
        (args.root / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        for process in services.values():
            if process.poll() is None:
                process.send_signal(signal.SIGTERM)
            process.wait(timeout=15)


if __name__ == "__main__":
    main()
