#!/usr/bin/env python3
"""Read-only candidate/installed gate for the separately selected Mesh reader."""

import argparse
import hashlib
import json
import os
import re
import socket
import struct
import subprocess
import tempfile
from pathlib import Path

ROOT = None
SELECTION = None
OBSERVER_SELECTION = None
TARGETS = {
    ".local/bin/agent-observer": None,
    ".local/bin/mesh-plus": 0o755,
    ".config/mesh-plus/sources.toml": 0o600,
    ".config/systemd/user/mesh-plus-agent.service": 0o644,
    ".config/systemd/user/default.target.wants/mesh-plus-agent.service": None,
}


def require(ok, code):
    if not ok:
        raise ValueError(code)


def run(argv):
    result = subprocess.run(argv, capture_output=True, timeout=40, cwd="/tmp", check=False)
    require(result.returncode == 0, "mesh_operations_command_failed")
    return result.stdout


def artifact(selection, host, profiles):
    home = Path.home()
    relative = Path(selection["readerPrefix"])
    require(
        not relative.is_absolute()
        and ".." not in relative.parts
        and relative.parts[:3] == (".local", "share", "agent-observer")
        and len(relative.parts) == 4,
        "mesh_reader_prefix",
    )
    require(selection["archive"] == str(relative / "artifact"), "mesh_archive_path")
    prefix, archive = home / relative, home / selection["archive"]
    observer, mesh = selection["observer"], selection["mesh"]
    require(
        all(re.fullmatch(r"[0-9A-Za-z.]+", m["version"]) for m in (observer, mesh)),
        "mesh_archive_version",
    )
    for name, expected in (
        (f"observer-{observer['version']}.json", observer),
        (f"mesh-{mesh['version']}.json", mesh),
    ):
        require(json.loads((archive / name).read_text()) == expected, "mesh_archive_manifest")
    verifier = archive / "verify-mesh-artifact"
    require(
        hashlib.sha256(verifier.read_bytes()).hexdigest() == selection["verifierSha256"],
        "mesh_verifier_identity",
    )
    receipt = json.loads(
        run(
            [
                str(verifier),
                "--prefix",
                str(prefix),
                "--archive",
                str(archive),
                "--profile",
                profiles[host],
            ]
        )
    )
    return prefix, receipt


def compatible_bridge(reader, bridge):
    """Independent immutable artifacts must share the frozen delivery contract."""
    require(reader["mesh"]["agentProfile"] == bridge["mesh"]["agentProfile"]
            == "agent-observer.mesh-candidate.v1"
            and reader["mesh"]["lockSha256"] == bridge["mesh"]["lockSha256"]
            == "2b93e1c1e0b533be00e6646ea0ef62aefec357ba00e1e8a51489578ccde38489",
            "mesh_bridge_contract_selection")


def verify(host, candidate):
    home = Path.home()
    value = json.loads((SELECTION).read_text())
    base = json.loads((OBSERVER_SELECTION).read_text())
    require(
        host in value["hosts"] and value["readerPrefix"] == base["readerPrefix"],
        "mesh_reader_selection",
    )
    prefix, receipt = artifact(value, host, value["profiles"])
    bridge = value.get("bridgeSelection", value)
    compatible_bridge(value, bridge)
    bridge_prefix, bridge_receipt = (
        (prefix, receipt) if bridge is value else artifact(bridge, host, value["profiles"])
    )
    rendered = {}
    for target, mode in TARGETS.items():
        rendered[target] = run(
            [
                "chezmoi",
                "--source",
                str(ROOT),
                "--refresh-externals=never",
                "cat",
                str(home / target),
            ]
        )
        if not candidate:
            path = home / target
            require(path.lstat().st_uid == os.getuid(), "mesh_target_owner")
            require(
                os.readlink(path).encode() == rendered[target].strip()
                if mode is None
                else not path.is_symlink()
                and path.read_bytes() == rendered[target]
                and path.stat().st_mode & 0o777 == mode,
                "mesh_target_drift",
            )
    with tempfile.TemporaryDirectory(prefix="mesh-unit-check-") as d:
        unit = Path(d) / value["unit"]
        unit.write_bytes(rendered[".config/systemd/user/mesh-plus-agent.service"])
        run(["systemd-analyze", "--user", "verify", str(unit)])
    result = {
        "status": "accepted",
        "host": host,
        "candidateOnly": candidate,
        "artifact": receipt,
        "bridgeArtifact": bridge_receipt,
        "serviceSelection": base["prefix"],
        "writerSelection": base["writerPrefix"],
        "renderedTargets": len(TARGETS),
    }
    if not candidate:
        require(
            run(["systemctl", "--user", "is-active", value["unit"]]).strip() == b"active",
            "mesh_unit_inactive",
        )
        require(
            run(["systemctl", "--user", "is-enabled", value["unit"]]).strip() == b"enabled",
            "mesh_unit_disabled",
        )
        pid = int(run(["systemctl", "--user", "show", value["unit"], "-p", "MainPID", "--value"]))
        require(pid > 0, "mesh_unit_pid")
        process = Path(f"/proc/{pid}")
        birth = process.joinpath("stat").read_text().rsplit(")", 1)[1].split()[19]
        endpoint = Path(f"/run/user/{os.getuid()}") / value["socket"]
        argv = process.joinpath("cmdline").read_bytes().rstrip(b"\0").split(b"\0")
        require(
            argv[1:]
            == [
                os.fsencode(bridge_prefix / "bin/mesh-plus"),
                b"serve",
                b"--source",
                b"agent",
                b"--socket",
                os.fsencode(endpoint),
            ]
            and process.joinpath("exe").resolve() == (bridge_prefix / "bin/python").resolve(),
            "mesh_live_artifact",
        )
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as peer:
            peer.settimeout(3)
            peer.connect(str(endpoint))
            peer_pid, peer_uid, _ = struct.unpack(
                "3i", peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
            )
            require(peer_pid == pid and peer_uid == os.getuid(), "mesh_live_endpoint_owner")
        require(
            process.joinpath("stat").read_text().rsplit(")", 1)[1].split()[19] == birth,
            "mesh_live_incarnation_changed",
        )
        result["liveBridge"] = {
            "pid": pid,
            "startTicks": birth,
            "kernelPeerMatchesUnit": True,
            "entryAndInterpreterVerified": True,
        }
        read = subprocess.run(
            [str(home / ".local/bin/agent-observer"), "mesh", "snapshot", "--scope", "local"],
            capture_output=True,
            timeout=30,
            check=True,
            cwd="/tmp",
        )
        frame = json.loads(read.stdout)
        require(
            frame["protocol"] == value["mesh"]["agentProfile"]
            and frame["mesh"]["status"] == "complete"
            and frame["mesh"]["scope"]["hostIds"] == [host],
            "mesh_local_read",
        )
        result["cachedRows"] = len(frame["sessions"])
    return result


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", choices=("snap", "starship"), required=True)
    parser.add_argument("--candidate", action="store_true")
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--selection", type=Path, required=True)
    parser.add_argument("--observer-selection", type=Path, required=True)
    args = parser.parse_args()
    ROOT = args.source.resolve(strict=True)
    SELECTION = args.selection.resolve(strict=True)
    OBSERVER_SELECTION = args.observer_selection.resolve(strict=True)
    try:
        print(json.dumps(verify(args.host, args.candidate), indent=2))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        code = str(error)
        if re.fullmatch(r"[a-z][a-z0-9_]{0,127}", code) is None:
            code = "mesh_operations_invalid"
        print(json.dumps({"status": "rejected", "reason": code}))
        raise SystemExit(1) from None
