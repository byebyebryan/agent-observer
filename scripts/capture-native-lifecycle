#!/usr/bin/env python3
"""Neutral, bounded metadata capture only inside an owned native proof."""

import json
import os
import re
import stat
import sys
from pathlib import Path


def capture():
    root = Path(os.environ["NATIVE_PROOF_ROOT"])
    state = json.loads((root / "runtime.json").read_text())
    assert os.getuid() == 0 and not state.get("stopped")
    assert all(os.readlink("/proc/self/ns/" + k) == v for k, v in state["namespaces"].items())
    data = sys.stdin.buffer.read(1024 * 1024 + 1)
    assert len(data) <= 1024 * 1024
    value = json.loads(data)
    sid = value.get("session_id")
    assert isinstance(sid, str) and re.fullmatch(r"[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}", sid)
    event = value.get("hook_event_name")
    assert event in {"PreToolUse", "SessionEnd", "Notification"}
    record = {"event": event, "nativeId": sid}
    if event == "PreToolUse":
        record["askUserQuestion"] = value.get("tool_name") == "AskUserQuestion"
    elif event == "SessionEnd":
        record["promptInputExit"] = value.get("reason") == "prompt_input_exit"
    else:
        kind = value.get("notification_type")
        record["signal"] = kind if kind in {"permission_prompt", "idle_prompt", "elicitation_dialog"} else "unknown"
    fd = os.open(root / "lifecycle-events.jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        metadata = os.fstat(fd)
        assert stat.S_ISREG(metadata.st_mode) and metadata.st_uid == os.getuid()
        assert metadata.st_size < 65536 and metadata.st_mode & 0o777 == 0o600
        os.write(fd, (json.dumps(record) + "\n").encode())
    finally:
        os.close(fd)


try:
    capture()
except Exception:
    pass
print("{}")
