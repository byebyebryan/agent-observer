#!/usr/bin/env python3
"""Independent schema/epoch proof over SSH; no provider calls or autostart.

Run with a Python environment containing jsonschema. Native comparisons remain
a separate gate. Each remote CLI validates its host-local clock and socket peer;
this consumer never compares remote BOOTTIME to its own clock.
"""

import argparse
import json
import os
import select
import subprocess
import time

from jsonschema import Draft202012Validator


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", choices=("snap", "starship"), required=True)
    parser.add_argument("--cli", required=True)
    args = parser.parse_args()
    if not args.cli.startswith("/home/bryan/.local/share/agent-observer/") or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/._-" for c in args.cli):
        raise ValueError("explicit_candidate_path_required")
    base = ["ssh", "-o", "BatchMode=yes", args.host, "rtk", "proxy", args.cli, "service"]
    schema = subprocess.run(base + ["schema", "--kind", "frame"], capture_output=True, check=True, timeout=20)
    assert len(schema.stdout) < 1024 * 1024
    validator = Draft202012Validator(json.loads(schema.stdout))
    receipts = []
    for target_count in (2, 3):
        process = subprocess.Popen(base + ["watch", "--host-scope", args.host, "--count", "3"],
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
        pending, frames = bytearray(), []
        started = time.monotonic()
        try:
            while len(frames) < target_count:
                assert time.monotonic() - started < 75, "remote_stream_timeout"
                if not select.select([process.stdout], [], [], 1)[0]:
                    continue
                chunk = os.read(process.stdout.fileno(), 65536)
                assert chunk, "remote_stream_eof"
                pending.extend(chunk)
                assert len(pending) <= 16 * 1024 * 1024, "remote_frame_limit"
                while b"\n" in pending and len(frames) < target_count:
                    line, _, rest = pending.partition(b"\n")
                    pending = bytearray(rest)
                    frame = json.loads(line)
                    validator.validate(frame)
                    assert frame["hostScope"] == args.host and frame["uid"] == os.getuid()
                    assert frame["sequence"] == len(frames) + 1
                    if frames:
                        assert frame["serviceId"] == frames[0]["serviceId"]
                        assert frame["bootId"] == frames[0]["bootId"]
                        assert frame["clockDomain"] == frames[0]["clockDomain"]
                        assert frame["viewRevision"] >= frames[-1]["viewRevision"]
                    frames.append(frame)
            receipts.append({"connection": len(receipts) + 1, "serviceId": frames[0]["serviceId"],
                             "initialSequence": frames[0]["sequence"], "finalSequence": frames[-1]["sequence"],
                             "kinds": [f["kind"] for f in frames], "durationSeconds": time.monotonic() - started,
                             "schemaAccepted": True, "viewDiscardedOnDisconnect": True})
        finally:
            if process.poll() is None:
                process.terminate()
            process.wait(timeout=10)
            process.stdout.close()
    assert receipts[0]["serviceId"] == receipts[1]["serviceId"]
    print(json.dumps({"status": "accepted", "hostScope": args.host, "connections": receipts,
                      "samePublisherAcrossReconnect": True, "newConnectionEpoch": True,
                      "ordinaryProviderActions": False, "referenceImportsObserver": False,
                      "localBoottimeComparedWithRemote": False, "providerInvocations": 0,
                      "nativeCompletenessProved": False, "networkReplayClaimed": False}))


if __name__ == "__main__":
    main()
