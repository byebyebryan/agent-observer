#!/usr/bin/env python3
"""Independent private native-to-cached-view latency, age and feed-loss proof."""

import argparse
import json
import os
from pathlib import Path
import runpy
import signal
import subprocess
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("codex", "claude"), required=True)
    parser.add_argument("--turns", type=int, default=3)
    args = parser.parse_args()
    assert 1 <= args.turns <= 4
    root, host = Path(os.environ["NATIVE_PROOF_ROOT"]), os.environ["NATIVE_PROOF_HOST"]
    assert os.getuid() == 0 and all(json.loads((root / "ready.json").read_text()).values())
    assert args.provider != "claude" or host == "snap"
    Proof = runpy.run_path(str(root / "native-acceptance"))["Proof"]
    reference = runpy.run_path(str(root / "evaluate-observation"))
    proof, service = Proof(args.provider), None
    image_cache, samples, target = {}, [], None
    path = proof.base / ("runtime/hints-" + args.provider) / "read.sock"
    diagnostic = path.parent / "hints.json"

    def native():
        if args.provider == "claude":
            return reference["claude_reference"](proof.base / "claude", image_cache)
        rpc = reference["NativeRPC"](proof.base / "codex")
        try:
            return reference["codex_reference"](rpc)
        finally:
            rpc.close()

    def frame():
        return proof.command(["agent-observer", "service", "snapshot", "--host-scope", host, "--socket", str(path)])

    def await_view(stage, fields, native_predicate, *, component="runtime", timeout=75):
        deadline, observed = time.monotonic() + timeout, None
        while time.monotonic() < deadline:
            for client in list(proof.clients):
                proof.pause(client, 0.1)
            before = native()["rows"].get(target)
            if not before or not native_predicate(before):
                continue
            observed = observed or time.monotonic()
            value = frame()
            row = next((r for r in (value["snapshot"] or {}).get("sessions", []) if r["identity"]["nativeId"] == target), None)
            after = native()["rows"].get(target)
            if not after or not native_predicate(after) or any(before.get(k) != after.get(k) for k in fields):
                continue
            if row is None:
                continue
            actual = {"runtime": row["runtime"]["value"], "phase": row["phase"]["value"],
                      "activity": row["activity"]["at"], "title": row["title"], "cwd": row["cwd"]}
            if any(actual[k] != after.get(k) for k in fields):
                continue
            receipt = next(c for s in value["sources"] if s["provider"] == args.provider for c in s["components"] if c["name"] == component)
            if receipt["health"] not in {"current", "partial"}:
                continue
            delay = time.monotonic() - observed
            hints = json.loads(diagnostic.read_text())["providers"][args.provider]
            hint_at = hints["last" + component.title() + "HintBoottimeMs"]
            samples.append({"stage": stage, "component": component, "nativeObservedToViewSeconds": delay,
                            "activityAt": actual["activity"], "phase": actual["phase"],
                            # The bounded feed carries no conversation ID. Its
                            # latest hint may follow the sample already in view;
                            # this signed diagnostic is not event/view latency.
                            "latestHintRelativeToSampleMs": receipt["sampledBoottimeMs"] - hint_at if hint_at is not None else None,
                            "nativeBracketStable": True, "fields": fields})
            return row
        raise RuntimeError("native_hint_" + stage + "_pending")

    try:
        # Explicit fixture bootstrap precedes passive monitoring. A fresh
        # endpoint cannot be started by observation just to obtain its feed.
        if args.provider == "codex":
            bootstrap = proof.spawn(proof.handoff())
            proof.pause(bootstrap, 5)
            proof.assert_native_client(bootstrap)
            proof.stop(bootstrap)
        before = native()
        interval = (30, 120) if host == "snap" else (20, 60)
        service = subprocess.Popen(["agent-observer-service", "serve", "--host-scope", host,
                                   "--provider", args.provider, "--socket", str(path),
                                   "--runtime-interval", str(interval[0]), "--history-interval", str(interval[1]),
                                   "--native-hints", "--hint-diagnostics", str(diagnostic)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            assert service.poll() is None
            if diagnostic.exists() and json.loads(diagnostic.read_text())["providers"][args.provider]["ready"]:
                value = frame()
                if value["snapshot"] and all(c["accepted"] for s in value["sources"] for c in s["components"]):
                    break
            time.sleep(.1)
        else:
            raise RuntimeError("native_hint_source_unavailable")
        after = native()
        if args.provider == "codex":
            assert before["loaded"] == after["loaded"]
        created = proof.handoff()
        viewer = proof.spawn(created)
        if args.provider == "claude":
            target = created["resultingIdentity"]["nativeId"]
        else:
            deadline = time.monotonic() + 20
            while time.monotonic() < deadline:
                proof.pause(viewer, .1)
                now = native()
                candidates = [sid for sid in set(now["loaded"]) - set(before["loaded"]) if now["rows"][sid]["kind"] == "user"]
                if len(candidates) == 1:
                    target = candidates[0]
                    break
            assert target is not None
        row = await_view("new", ["runtime", "cwd"], lambda r: r.get("runtime") == "running")
        ref = row["identity"]
        proof.assert_native_client(viewer)
        for turn in range(args.turns):
            os.write(viewer[1], b"\x1b[200~Run a shell command that sleeps 5 seconds, then reply only OK.\x1b[201~\r")
            if args.provider == "codex":
                proof.pause(viewer, .5)
                os.write(viewer[1], b"\r")
            await_view("working_" + str(turn), ["runtime", "phase"], lambda r: r.get("phase") == "working")
            row = await_view("completed_" + str(turn), ["runtime", "phase"], lambda r: r.get("phase") == "waiting")
            row = await_view("activity_" + str(turn), ["activity"], lambda r: r.get("phase") == "waiting" and r.get("activity") is not None, component="history")
        at = row["activity"]["at"]
        if args.provider == "codex":
            proof.codex_metadata(ref, rename=True, touch=True)
        else:
            os.write(viewer[1], b"/rename Activity proof renamed\r")
        row = await_view("rename", ["title", "activity"], lambda r: r.get("title") == "Activity proof renamed" and r.get("activity") == at, component="history", timeout=30)
        assert row["activity"]["at"] == at
        # Kill only the exact publisher child feed, then prove a new owned feed
        # incarnation and unchanged conversation clock through reconnect.
        children = Path(f"/proc/{service.pid}/task/{service.pid}/children").read_text().split()
        feeds = [int(pid) for pid in children if b"_hint_worker.py" in Path(f"/proc/{pid}/cmdline").read_bytes()]
        assert len(feeds) == 1
        starts = json.loads(diagnostic.read_text())["providers"][args.provider]["starts"]
        os.kill(feeds[0], signal.SIGKILL)
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            for client in list(proof.clients):
                proof.pause(client, .1)
            counters = json.loads(diagnostic.read_text())["providers"][args.provider]
            if counters["ready"] and counters["starts"] > starts and counters["losses"]:
                break
        else:
            raise RuntimeError("native_hint_reconnect_pending")
        row = await_view("reconnected", ["runtime", "activity"], lambda r: r.get("runtime") == "running" and r.get("activity") == at, component="history")
        runtime = sorted(s["nativeObservedToViewSeconds"] for s in samples if s["component"] == "runtime")
        history = sorted(s["nativeObservedToViewSeconds"] for s in samples if s["component"] == "history")
        def p95(values):
            return values[max(0, __import__('math').ceil(len(values) * .95) - 1)]
        receipt = {"status": "accepted" if p95(runtime) <= 5 and p95(history) <= 15 else "latency_target_missed",
                   "hostScope": host, "provider": args.provider, "nativeId": target,
                   "runtimeP95Seconds": p95(runtime), "historyP95Seconds": p95(history),
                   "samples": samples, "runtimeSamples": len(runtime), "historySamples": len(history),
                   "sourceReconnectAccepted": True, "passiveLoadedBookends": args.provider == "codex",
                   "eventToViewLatencyClaimed": False,
                   "periodicIntervalsSeconds": interval, "ordinaryProviderActions": False,
                   "nativeReferenceImportsObserver": False, "terminalOutputPersisted": False}
        (root / ("hint-receipt-" + args.provider + ".json")).write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        for client in list(proof.clients):
            proof.stop(client)
        if service is not None:
            if service.poll() is None:
                service.send_signal(signal.SIGTERM)
            service.wait(timeout=15)


if __name__ == "__main__":
    main()
