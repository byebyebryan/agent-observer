#!/usr/bin/env python3
"""Private exact-ID background question versus an owned hinted cache."""

import json
import os
from pathlib import Path
import re
import runpy
import signal
import subprocess
import time


def main():
    root = Path(os.environ["NATIVE_PROOF_ROOT"])
    assert os.geteuid() == 0 and os.environ["NATIVE_PROOF_HOST"] == "snap"
    assert all(json.loads((root / "ready.json").read_text()).values())
    proof = runpy.run_path(str(root / "native-acceptance"))["Proof"]("claude")
    path = root / "ipc/read.sock"
    service, observed, held = None, None, []
    try:
        service = subprocess.Popen(["agent-observer-service", "serve", "--host-scope", "snap",
                                    "--provider", "claude", "--runtime-interval", "30",
                                    "--history-interval", "120", "--socket", str(path),
                                    "--native-hints"], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
        created = proof.handoff()
        target = created["resultingIdentity"]["nativeId"]
        viewer = proof.spawn(created)
        proof.pause(viewer, 8)
        proof.assert_native_client(viewer)

        def native_question():
            for file in (proof.base / "claude/sessions").glob("*.json"):
                try:
                    record = json.loads(file.read_text())
                except (OSError, ValueError):
                    return False
                if record.get("sessionId") != target:
                    continue
                job_id = record.get("jobId")
                if not isinstance(job_id, str) or not re.fullmatch(r"[a-f0-9]{8}", job_id):
                    return False
                try:
                    job = json.loads((proof.base / "claude/jobs" / job_id / "state.json").read_text())
                except (OSError, ValueError):
                    return False
                questions = (job.get("block") or {}).get("questions")
                return (record.get("status") == "waiting" and record.get("waitingFor") == "input needed"
                        and job.get("sessionId") == target and job.get("state") == "working"
                        and job.get("tempo") == "blocked" and isinstance(questions, list)
                        and 1 <= len(questions) <= 32 and all(isinstance(q, dict) for q in questions))
            return False

        os.write(viewer[1], b"\x1b[200~Use AskUserQuestion to ask which colour I prefer with options Red and Blue. Wait for my answer.\x1b[201~\r")
        deadline, latency = time.monotonic() + 75, None
        while time.monotonic() < deadline:
            proof.pause(viewer, .15)
            if not native_question():
                continue
            observed = observed or time.monotonic()
            frame = proof.command(["agent-observer", "service", "snapshot", "--host-scope", "snap", "--socket", str(path)])
            row = next((r for r in (frame["snapshot"] or {}).get("sessions", []) if r["identity"]["nativeId"] == target), None)
            if not native_question() or row is None or row["phase"]["value"] != "blocked" or row["blockedReason"] != "question":
                continue
            assert row["phase"]["health"] == "current" and row["runtime"]["value"] == "running"
            latency = latency if latency is not None else time.monotonic() - observed
            held.append({"nativeBracketStable": True, "phase": "blocked", "blockedReason": "question"})
            if len(held) == 3:
                break
        assert len(held) == 3 and latency <= 5
        receipt = {"status": "accepted", "hostScope": "snap", "provider": "claude", "nativeId": target,
                   "nativeQuestionFirstObservedToCachedSeconds": latency, "heldQuestionSamples": held,
                   "questionNotAnswered": True, "ordinaryProviderActions": False,
                   "terminalOutputPersisted": False, "eventArrivalLatencyClaimed": False}
        (root / "cached-question-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        for viewer in list(proof.clients):
            proof.stop(viewer)
        if service is not None:
            if service.poll() is None:
                service.send_signal(signal.SIGTERM)
            service.wait(timeout=15)


if __name__ == "__main__":
    main()
