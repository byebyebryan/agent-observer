#!/usr/bin/env python3
"""Exercise only the gated Mesh bridge/read selection and captured prior targets."""

import argparse
import hashlib
import json
import os
import subprocess
from pathlib import Path


def run(argv):
    return subprocess.run(argv, capture_output=True, check=True, timeout=45).stdout


def bridge_identity(value, home):
    """Authenticate the independently selected resident bridge, never a reader."""
    bridge = value.get("bridgeSelection", value)
    relative = Path(bridge["readerPrefix"])
    if (
        relative.is_absolute()
        or ".." in relative.parts
        or relative.parts[:3] != (".local", "share", "agent-observer")
        or len(relative.parts) != 4
    ):
        raise ValueError("selection_bridge_prefix")
    prefix = home / relative
    unit = value["unit"]
    pid = int(run(["systemctl", "--user", "show", unit, "-p", "MainPID", "--value"]))
    if pid <= 0:
        raise ValueError("selection_unit_inactive")
    process = Path(f"/proc/{pid}")
    started = process.joinpath("stat").read_text().rsplit(")", 1)[1].split()[19]
    argv = process.joinpath("cmdline").read_bytes().rstrip(b"\0").split(b"\0")
    endpoint = Path(f"/run/user/{os.getuid()}") / value["socket"]
    if (
        process.stat().st_uid != os.getuid()
        or process.joinpath("exe").resolve() != (prefix / "bin/python").resolve()
        or argv[1:]
        != [os.fsencode(prefix / "bin/mesh-plus"), b"serve", b"--source",
            value["source"].encode(), b"--socket", os.fsencode(endpoint)]
    ):
        raise ValueError("selection_foreign_unit")
    if (
        pid != int(run(["systemctl", "--user", "show", unit, "-p", "MainPID", "--value"]))
        or process.joinpath("stat").read_text().rsplit(")", 1)[1].split()[19] != started
    ):
        raise ValueError("selection_unit_changed")
    return {"pid": pid, "startTicks": started}


def same_bridge(value, home, expected):
    if bridge_identity(value, home) != expected:
        raise ValueError("selection_unit_changed")


def main(host, root, selection_path, observer_selection, baseline_path):
    home = Path.home()
    baseline = json.loads(baseline_path.read_text())
    value = json.loads(selection_path.read_text())
    targets = baseline["targets"]
    expected_targets = {
        ".local/bin/agent-observer",
        ".local/bin/mesh-plus",
        ".config/mesh-plus/sources.toml",
        ".config/systemd/user/mesh-plus-agent.service",
        ".config/systemd/user/default.target.wants/mesh-plus-agent.service",
    }
    if set(targets) != expected_targets or host not in value["hosts"]:
        raise ValueError("selection_scope_invalid")
    run(
        [
            str(Path(__file__).with_name("agent-observer-mesh-operations")),
            "--host",
            host,
            "--source",
            str(root),
            "--selection",
            str(selection_path),
            "--observer-selection",
            str(observer_selection),
        ]
    )
    unit = value["unit"]
    identity = bridge_identity(value, home)
    desired = {
        t: run(
            ["chezmoi", "--source", str(root), "--refresh-externals=never", "cat", str(home / t)]
        )
        for t in targets
    }
    prior = None
    same_bridge(value, home, identity)
    try:
        run(["systemctl", "--user", "stop", unit])
        for target, saved in targets.items():
            path = home / target
            if path.exists() or path.is_symlink():
                path.unlink()
            if saved["kind"] == "symlink":
                path.symlink_to(saved["value"])
            elif saved["kind"] == "file":
                path.write_text(saved["value"])
                path.chmod(saved["mode"])
        run(["systemctl", "--user", "daemon-reload"])
        if (
            os.readlink(home / ".local/bin/agent-observer")
            != targets[".local/bin/agent-observer"]["value"]
        ):
            raise ValueError("selection_prior_reader_changed")
        prior = run([str(home / ".local/bin/agent-observer"), "--version"]).decode().strip()
        cache = json.loads(
            run(
                [str(home / ".local/bin/agent-observer"), "service", "status", "--host-scope", host]
            )
        )
        if cache["state"] != "ready":
            raise ValueError("selection_prior_cache_unavailable")
    finally:
        # Forced apply is allowed only for a target still matching this owned
        # restored baseline or the reviewed candidate, never unrelated drift.
        for target, saved in targets.items():
            path = home / target
            if not path.exists() and not path.is_symlink():
                allowed = saved["kind"] == "absent"
            elif path.is_symlink():
                allowed = os.readlink(path) in [
                    desired[target].decode().strip(),
                    saved.get("value"),
                ]
            else:
                allowed = (
                    path.read_bytes() == desired[target]
                    or saved["kind"] == "file"
                    and path.read_text() == saved["value"]
                )
            if not allowed:
                raise ValueError("selection_target_changed")
        first = [str(home / t) for t in targets if "default.target.wants" not in t]
        first[first.index(str(home / ".config/mesh-plus/sources.toml"))] = str(
            home / ".config/mesh-plus"
        )
        for selected in (
            first,
            [str(home / ".config/systemd/user/default.target.wants/mesh-plus-agent.service")],
        ):
            run(
                [
                    "chezmoi",
                    "--source",
                    str(root),
                    "--refresh-externals=never",
                    "apply",
                    "--force",
                    "--exclude",
                    "scripts",
                    *selected,
                ]
            )
        run(["systemctl", "--user", "daemon-reload"])
        run(["systemctl", "--user", "start", unit])
    receipt = json.loads(
        run(
            [
                str(Path(__file__).with_name("agent-observer-mesh-operations")),
                "--host",
                host,
                "--source",
                str(root),
                "--selection",
                str(selection_path),
                "--observer-selection",
                str(observer_selection),
            ]
        )
    )
    current = run(
        [
            "systemctl",
            "--user",
            "show",
            "agent-observer.service",
            "-p",
            "MainPID",
            "-p",
            "ActiveState",
            "-p",
            "NRestarts",
        ]
    ).decode()
    if current != baseline["observerUnit"] or not all(
        hashlib.sha256((home / t).read_bytes()).hexdigest() == sha
        for t, sha in baseline["protectedHashes"].items()
    ):
        raise ValueError("selection_preservation_failed")
    return {
        "host": host,
        "priorCli": prior,
        "baselineTargetsRestored": len(targets),
        "priorCachedReadReady": True,
        "reselectedGate": receipt["status"],
        "observerUnitUnchanged": True,
        "protectedHashesUnchanged": True,
        "bridgeUnitOnlyStopped": True,
        "verifiedScopedForceReselection": True,
    }


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", choices=("snap", "starship"), required=True)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--selection", type=Path, required=True)
    parser.add_argument("--observer-selection", type=Path, required=True)
    parser.add_argument("--baseline", type=Path, required=True)
    args = parser.parse_args()
    try:
        print(
            json.dumps(
                main(
                    args.host,
                    args.source.resolve(strict=True),
                    args.selection.resolve(strict=True),
                    args.observer_selection.resolve(strict=True),
                    args.baseline.resolve(strict=True),
                ),
                indent=2,
            )
        )
    except Exception:
        print(json.dumps({"error": "mesh_selection_acceptance_failed"}))
        raise SystemExit(1) from None
