#!/usr/bin/env python3
"""Read-only bounded parser parity/cost study; no provider/client invocation."""
import argparse
import hashlib
import importlib.util
import json
import os
import sys
import tempfile
import time
from pathlib import Path
from unittest.mock import patch

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agent_observer import _claude_history_worker as worker
from agent_observer._claude_file_memo import FileMemo


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config-home', required=True, type=Path)
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    if not args.config_home.is_absolute() or args.config_home.resolve(strict=True) != args.config_home:
        raise ValueError('study_namespace')
    reference_path = Path(__file__).resolve().parent.parent / 'tests/claude_transcript_reference.py'
    spec = importlib.util.spec_from_file_location('_claude_frozen_reference', reference_path)
    reference = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(reference)
    census = worker.census_projects(args.config_home / 'projects')
    paths = sorted(census['transcript_paths'].items())
    memo = FileMemo(args.config_home)
    summaries, projections = {}, {}
    stamps = {sid: worker._file_stamp(path.lstat()) for sid, path in paths}
    def run(name, function, *, count=False):
        loads = json.loads
        counters = {'decodedRecords': 0, 'decoderInputBytes': 0}
        def counted(data, *a, **kw):
            counters['decodedRecords'] += 1
            counters['decoderInputBytes'] += len(data)
            return loads(data, *a, **kw)
        begin, cpu = time.monotonic(), time.process_time()
        with patch.object(json, 'loads', counted if count else loads):
            values = {sid: function(path, sid) for sid, path in paths}
        summaries[name] = {'wallSeconds': time.monotonic() - begin, 'ownCpuSeconds': time.process_time() - cpu,
                           'files': len(values), **(counters if count else {})}
        projections[name] = values
        return values
    frozen = lambda path, sid: {'activity': reference.transcript_activity(path, sid), 'kind': reference.transcript_kind(path, sid)}
    run('referenceTimed', frozen)
    run('sharedColdTimed', worker.transcript_metadata)
    run('memoFillTimed', lambda p, sid: worker.transcript_metadata(p, sid, file_memo=memo))
    run('memoWarmTimed', lambda p, sid: worker.transcript_metadata(p, sid, file_memo=memo))
    run('referenceCounted', frozen, count=True)
    run('sharedColdCounted', worker.transcript_metadata, count=True)
    run('memoWarmCounted', lambda p, sid: worker.transcript_metadata(p, sid, file_memo=memo), count=True)
    stable = {sid for sid, path in paths if worker._file_stamp(path.lstat()) == stamps[sid]}
    mismatches = [sid for sid in stable if any(projections[name][sid] != projections['referenceTimed'][sid] for name in projections)]
    # A synthetic changed file proves reuse scope without mutating ordinary history.
    with tempfile.TemporaryDirectory(prefix='ao-claude-delta-study-') as directory:
        home = Path(directory)
        project = home / 'projects/project'
        project.mkdir(parents=True)
        synthetic = []
        for i in range(3):
            sid = f'{i:08x}-0123-4567-89ab-0123456789ab'
            p = project / (sid + '.jsonl')
            p.write_text(json.dumps({'type': 'user', 'sessionId': sid, 'isSidechain': False,
                'timestamp': '2026-10-10T00:00:00Z', 'message': {'role': 'user', 'content': 'fixture'}}) + '\n')
            synthetic.append((sid, p))
        synthetic_memo = FileMemo(home)
        old = [worker.transcript_metadata(p, sid, file_memo=synthetic_memo) for sid, p in synthetic]
        changed = synthetic[1][1]
        changed.write_text(changed.read_text().replace('00:00:00Z', '00:00:01Z'))
        loads = json.loads
        count = [0]
        def counter(data, *a, **kw):
            count[0] += 1
            return loads(data, *a, **kw)
        with patch.object(json, 'loads', counter):
            new = [worker.transcript_metadata(p, sid, file_memo=synthetic_memo) for sid, p in synthetic]
        delta = {'files': 3, 'changedFiles': 1, 'decodedRecords': count[0],
            'unchangedProjectionsEqual': old[0] == new[0] and old[2] == new[2],
            'changedActivityDeltaMs': new[1]['activity']['at'] - old[1]['activity']['at']}
    output = {'studyVersion': 1, 'pythonVersion': sys.version.split()[0],
        'referenceSha256': hashlib.sha256(reference_path.read_bytes()).hexdigest(),
        'workerSha256': hashlib.sha256(Path(worker.__file__).read_bytes()).hexdigest(),
        'censusFiles': len(paths), 'stableFiles': len(stable), 'changedDuringStudy': len(paths) - len(stable),
        'stableParityMismatches': mismatches, 'studies': summaries,
        'memoEntries': len(memo.entries), 'memoEncodedBytes': len(json.dumps(memo.export()).encode()),
        'syntheticDelta': delta,
        'limits': ['parser component only; imports amortized', 'unknown/fault projections remain uncached',
                   'ordinary source changes excluded from stable parity', 'counting and timing are separate runs',
                   'no runtime registration or SDK-list proof', 'no raw provider contents retained']}
    args.output.write_text(json.dumps(output, indent=2) + '\n')
    print(json.dumps({'status': 'passed' if not mismatches and delta['decodedRecords'] == 1 else 'failed',
                      'stableFiles': len(stable), 'mismatches': len(mismatches)}))
    return 1 if mismatches or delta['decodedRecords'] != 1 else 0

if __name__ == '__main__':
    raise SystemExit(main())
