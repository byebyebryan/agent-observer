#!/usr/bin/env python3
"""Exact unloaded Codex saved rename; no load/resume to obtain observation."""

import json
import os
from pathlib import Path
import runpy
import signal
import subprocess
import time


def main():
    root = Path(os.environ["NATIVE_PROOF_ROOT"])
    assert os.geteuid() == 0 and all(json.loads((root / "ready.json").read_text()).values())
    Proof = runpy.run_path(str(root / "native-acceptance"))["Proof"]
    reference = runpy.run_path(str(root / "evaluate-observation"))
    proof = Proof("codex")
    sid = json.loads((root / "hint-receipt-codex.json").read_text())["nativeId"]
    def native():
        rpc = reference["NativeRPC"](proof.base / "codex")
        try:
            return reference["codex_reference"](rpc)
        finally:
            rpc.close()
    deadline = time.monotonic() + 120
    while sid in native()["loaded"]:
        assert time.monotonic() < deadline
        time.sleep(1)
    before = native()
    direct = proof.snapshot()
    ref = next(r["identity"] for r in direct["sessions"] if r["identity"]["nativeId"] == sid)
    path = proof.base / "runtime/saved-hints/read.sock"
    service = subprocess.Popen(["agent-observer-service", "serve", "--host-scope", proof.host,
                               "--provider", "codex", "--runtime-interval", "30" if proof.host == "snap" else "20",
                               "--history-interval", "120" if proof.host == "snap" else "60", "--native-hints", "--socket", str(path)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    def cached():
        return proof.command(["agent-observer", "service", "snapshot", "--host-scope", proof.host, "--socket", str(path)])
    try:
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            try:
                frame = cached()
                if frame["snapshot"] and any(r["identity"] == ref for r in frame["snapshot"]["sessions"]):
                    break
            except (RuntimeError, ValueError, OSError):
                pass
            time.sleep(.1)
        else:
            raise RuntimeError("saved_hint_warm_pending")
        started = time.monotonic()
        proof.codex_metadata(ref, rename=True, name="Saved history wakeup proof")
        assert native()["rows"][sid]["title"] == "Saved history wakeup proof"
        deadline = started + 20
        while time.monotonic() < deadline:
            frame = cached()
            row = next(r for r in frame["snapshot"]["sessions"] if r["identity"] == ref)
            if row["title"] == "Saved history wakeup proof":
                break
            time.sleep(.1)
        delay = time.monotonic() - started
        after = native()
        receipt = {"status": "accepted" if row["title"] == "Saved history wakeup proof" and delay <= 15 else "saved_hint_latency_missed",
                   "hostScope": proof.host, "provider": "codex", "nativeId": sid,
                   "renameActionStartToCachedSeconds": delay, "unloadedBeforeAndAfter": sid not in before["loaded"] and sid not in after["loaded"],
                   "loadedSetPreserved": before["loaded"] == after["loaded"],
                   "nativeActivityPreserved": before["rows"][sid]["activity"] == after["rows"][sid]["activity"] == row["activity"]["at"],
                   "historyReceipt": next(c for s in frame["sources"] for c in s["components"] if c["name"] == "history"),
                   "ordinaryProviderActions": False, "nativeReferenceImportsObserver": False}
        assert receipt["unloadedBeforeAndAfter"] and receipt["loadedSetPreserved"] and receipt["nativeActivityPreserved"]
        (root / "saved-hint-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        if service.poll() is None:
            service.send_signal(signal.SIGTERM)
        service.wait(timeout=15)


if __name__ == "__main__":
    main()
