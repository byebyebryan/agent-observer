#!/usr/bin/env python3
"""Check bootstrap documentation without invoking providers or services."""

from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote, urlsplit


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    files = [root / "README.md", root / "AGENTS.md"]
    files.extend(sorted((root / "docs").rglob("*.md")))
    errors = []

    for path in files:
        text = path.read_text(encoding="utf-8")
        label = path.relative_to(root)
        if not text.endswith("\n"):
            errors.append(f"{label}: missing final newline")
        fence = None
        for number, line in enumerate(text.splitlines(), 1):
            if line != line.rstrip():
                errors.append(f"{label}:{number}: trailing whitespace")
            match = re.match(r"^\s*(`{3,}|~{3,})", line)
            if match:
                marker = match.group(1)
                if fence is None:
                    fence = marker
                elif marker[0] == fence[0] and len(marker) >= len(fence):
                    fence = None
        if fence is not None:
            errors.append(f"{label}: unclosed code fence")
        for target in re.findall(r"\[[^\]]+\]\(([^)]+)\)", text):
            parsed = urlsplit(target)
            if parsed.scheme or parsed.netloc or not parsed.path:
                continue
            local = root / parsed.path.lstrip("/") if parsed.path.startswith("/") else path.parent / parsed.path
            if not local.exists():
                local = Path(unquote(str(local)))
                if not local.exists():
                    errors.append(f"{label}: missing local link target {target}")

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    for arguments in (["git", "diff", "--check"], ["git", "diff", "--cached", "--check"]):
        result = subprocess.run(arguments, cwd=root, check=False)
        if result.returncode:
            return result.returncode
    print(f"PASS: {len(files)} Markdown files, local links, whitespace, fences and Git diff checks")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
