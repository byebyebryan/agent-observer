#!/usr/bin/env python3
"""Check documentation and synthetic spike tests without invoking providers."""

import argparse
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlsplit


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--require-working-set-mesh", action="store_true",
        help="fail before tests unless the paired working-set SDK is installed",
    )
    args = parser.parse_args(argv)
    root = Path(__file__).resolve().parent.parent
    docs = subprocess.run([sys.executable, "scripts/check-docs"], cwd=root, check=False)
    if docs.returncode:
        return docs.returncode
    if args.require_working_set_mesh:
        # The script directory is sys.path[0] for the documented ./scripts/check
        # invocation. Prefer this checkout over any installed Observer package.
        sys.path.insert(0, str(root))
        try:
            from agent_observer.mesh_working_set_profile import WorkingSetAgentProfile

            WorkingSetAgentProfile()
        except (ImportError, ValueError):
            print(
                "FAIL: --require-working-set-mesh needs a compatible SDK with "
                "agent-observer.mesh-working-set.v1 registered",
                file=sys.stderr,
            )
            return 1
    files = [root / "README.md", root / "AGENTS.md"]
    files.extend(sorted((root / "docs").rglob("*.md")))
    errors = []

    for path in files:
        text = path.read_text(encoding="utf-8")
        label = path.relative_to(root)
        if not text.endswith("\n"):
            errors.append(f"{label}: missing final newline")
        fence = None
        for number, line in enumerate(text.splitlines(), 1):
            if line != line.rstrip():
                errors.append(f"{label}:{number}: trailing whitespace")
            match = re.match(r"^\s*(`{3,}|~{3,})", line)
            if match:
                marker = match.group(1)
                if fence is None:
                    fence = marker
                elif marker[0] == fence[0] and len(marker) >= len(fence):
                    fence = None
        if fence is not None:
            errors.append(f"{label}: unclosed code fence")
        for target in re.findall(r"\[[^\]]+\]\(([^)]+)\)", text):
            parsed = urlsplit(target)
            if parsed.scheme or parsed.netloc or not parsed.path:
                continue
            local = root / parsed.path.lstrip("/") if parsed.path.startswith("/") else path.parent / parsed.path
            if not local.exists():
                local = Path(unquote(str(local)))
                if not local.exists():
                    errors.append(f"{label}: missing local link target {target}")

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    for arguments in (["git", "diff", "--check"], ["git", "diff", "--cached", "--check"]):
        result = subprocess.run(arguments, cwd=root, check=False)
        if result.returncode:
            return result.returncode
    if (root / "tests").is_dir():
        result = subprocess.run(
            [sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-v"],
            cwd=root,
            check=False,
        )
        if result.returncode:
            return result.returncode
    print(f"PASS: {len(files)} Markdown files, local links, whitespace, fences and Git diff checks")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
