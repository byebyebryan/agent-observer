#!/usr/bin/env python3
"""Explicit operator proof inside native-isolation; discards all terminal output."""

import argparse
import fcntl
import hashlib
import json
import os
import pty
import select
import signal
import struct
import subprocess
import termios
import time
from pathlib import Path

from agent_observer import codex_transport
from agent_observer.codex_endpoint import inspect_managed_endpoint, validate_incarnation
from agent_observer.codex_transport import PassiveClient
from agent_observer.native_artifacts import CLAUDE_PREVIOUS, inspect_process


class Proof:
    def __init__(self, provider):
        self.root = Path(os.environ["NATIVE_PROOF_ROOT"])
        self.host = os.environ["NATIVE_PROOF_HOST"]
        self.base = self.root / ("native-" + self.host)
        self.provider = provider
        self.clients = []
        self.output_cues = {}
        self.ready = json.loads((self.root / "ready.json").read_text())
        assert os.getuid() == 0 and all(self.ready.values())
        assert Path(os.environ["HOME"]) == self.base / "home"
        assert Path(os.environ["CODEX_HOME"]) == self.base / "codex"
        assert Path(os.environ["CLAUDE_CONFIG_DIR"]) == self.base / "claude"
        os.chdir(self.base / "workspace")

    def command(self, argv):
        process = subprocess.run(argv, capture_output=True, timeout=40)
        if process.returncode:
            try:
                payload = json.loads(process.stderr or process.stdout)
                code = payload.get("error", payload.get("reason"))
                if isinstance(code, str) and len(code) <= 128 and code.replace("_", "").isalnum():
                    raise RuntimeError(code)
            except (ValueError, KeyError, TypeError):
                pass
            raise RuntimeError("public_command_failed")
        return json.loads(process.stdout)

    def snapshot(self):
        return self.command(
            ["agent-observer", "snapshot", "--host-scope", self.host, "--provider", self.provider]
        )

    def row(self, ref):
        return next(row for row in self.snapshot()["sessions"] if row["identity"] == ref)

    def handoff(self, ref=None):
        request = {
            "schemaVersion": 1,
            "operation": "resume" if ref else "new",
            "hostScope": self.host,
            "provider": self.provider,
            "configHome": str(self.base / self.provider),
            "configHomeKind": "explicit",
            "cwd": str(self.base / "workspace"),
            "reference": ref,
        }
        plan = self.command(
            ["agent-observer-write", "prepare", "--request-json", json.dumps(request)]
        )
        result = self.command(["agent-observer-write", "execute", "--plan-json", json.dumps(plan)])
        assert result["handoff"] is not None
        return result

    def spawn(self, result):
        pid, fd = pty.fork()
        if pid == 0:
            os.execvp(
                "agent-observer-write",
                ["agent-observer-write", "enter", "--plan-json", json.dumps(result["handoff"])],
            )
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))
        os.set_blocking(fd, False)
        client = (pid, fd)
        self.clients.append(client)
        return client

    def pause(self, client, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            fd = client[1]
            for _ in range(16):
                if not select.select([fd], [], [], 0)[0]:
                    break
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                cues = self.output_cues.setdefault(client[0], set())
                lowered = data.lower()
                for cue in (b"already attached", b"connection refused", b"handoff_context_changed", b"resume_evidence_unavailable", b"unsupported_resume_route", b"native_launch_uncertain", b"do you want to proceed?", b"allow this command?", b"do you want to allow"):
                    if cue in lowered:
                        cues.add(cue.decode())
                if b"\x1b[6n" in data:
                    os.write(fd, b"\x1b[1;1R")
                if b"\x1b[c" in data:
                    os.write(fd, b"\x1b[?1;2c")
            time.sleep(0.1)

    def stop(self, client):
        try:
            os.kill(client[0], signal.SIGHUP)
        except ProcessLookupError:
            pass
        os.waitpid(client[0], 0)
        os.close(client[1])
        self.clients.remove(client)

    def assert_native_client(self, client):
        expected = (
            Path("/opt/openai-codex/bin/codex")
            if self.provider == "codex"
            else Path("/opt/claude-code/bin/claude")
        )
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            state = Path(f"/proc/{client[0]}/stat").read_text().rsplit(")", 1)[1].split()[0]
            if state == "Z":
                raise RuntimeError("native_client_exited:" + ",".join(sorted(self.output_cues.get(client[0], set()))))
            if Path(f"/proc/{client[0]}/exe").resolve() == expected.resolve():
                self.pause(client, 2)
                return
            self.pause(client, 0.2)
        raise RuntimeError("native_client_not_entered")

    def codex_metadata(self, ref, *, rename=False, touch=False):
        owner = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert Path(os.readlink(f"/proc/{owner.pid}/exe")).is_relative_to(
            self.base / "codex/packages"
        )
        with PassiveClient.connect(
            owner.endpoint, expected_uid=owner.uid, expected_pid=owner.pid
        ) as client:
            assert client.initialize()["codexHome"] == str(self.base / "codex")
            before = client.loaded_threads()["data"]
            if rename:
                allowed = codex_transport._READ_METHODS
                codex_transport._READ_METHODS = allowed | {"thread/name/set"}
                try:
                    client._request(
                        "thread/name/set",
                        {"threadId": ref["nativeId"], "name": "Activity proof renamed"},
                    )
                finally:
                    codex_transport._READ_METHODS = allowed
            metadata = client.latest_turn(ref["nativeId"])
            if touch:
                path = Path(client.read_thread(ref["nativeId"])["thread"]["path"])
                assert path.is_relative_to(self.base / "codex")
                if path.exists():
                    os.utime(path, None)
            assert before == client.loaded_threads()["data"]
        validate_incarnation(owner)
        return metadata

    def run(self):
        prior = {row["identity"]["nativeId"] for row in self.snapshot()["sessions"]}
        created = self.handoff()
        client = self.spawn(created)
        self.pause(client, 5)
        self.assert_native_client(client)
        rows = self.snapshot()["sessions"]
        ref = (
            created["resultingIdentity"]
            if self.provider == "claude"
            else next(row["identity"] for row in rows if row["identity"]["nativeId"] not in prior)
        )
        empty = self.row(ref)
        assert empty["activity"]["at"] is None and empty["runtime"]["value"] == "running"
        os.write(client[1], b"Reply only with OK.\r")
        if self.provider == "codex":
            self.pause(client, 1)
            os.write(client[1], b"\r")
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            self.pause(client, 0.3)
            row = self.row(ref)
            if row["phase"]["value"] == "waiting" and row["activity"]["at"] is not None:
                break
        else:
            raise RuntimeError("native_turn_pending")
        at = row["activity"]["at"]
        if self.provider == "codex":
            turn = self.codex_metadata(ref)["data"][0]
            assert turn["items"] == [] and turn["itemsView"] == "notLoaded"
            assert turn["completedAt"] * 1000 == at
            self.codex_metadata(ref, rename=True, touch=True)
        else:
            os.write(client[1], b"/rename Activity proof renamed\r")
            self.pause(client, 3)
            for path in (self.base / "claude/projects").glob("*/*.jsonl"):
                if path.stem == ref["nativeId"]:
                    os.utime(path, None)
        renamed = self.row(ref)
        assert renamed["activity"]["at"] == at
        assert renamed["title"] == "Activity proof renamed"
        self.stop(client)
        resumed = self.spawn(self.handoff(ref))
        self.pause(resumed, 4)
        assert self.row(ref)["activity"]["at"] == at
        self.assert_native_client(resumed)
        repeated = self.spawn(self.handoff(ref))
        self.pause(repeated, 6)
        self.assert_native_client(repeated)
        assert self.row(ref)["activity"]["at"] == at
        self.stop(repeated)
        self.stop(resumed)
        return {
            "status": "accepted",
            "hostScope": self.host,
            "provider": self.provider,
            "isolation": self.ready,
            "independentOfFrontend": True,
            "emptyActivityUnknown": True,
            "nativeConversationActivity": True,
            "readsRenameHousekeepingPreserveAge": True,
            "savedOrLiveResumeExactIdentity": True,
            "resumePreservesAge": True,
            "repeatedNativeEntry": True,
            "terminalOutputPersisted": False,
        }

    def recovery(self):
        assert self.provider == "codex"
        ref = next(
            row["identity"]
            for row in self.snapshot()["sessions"]
            if row["activity"]["at"] is not None
        )
        at = self.row(ref)["activity"]["at"]
        owner = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert Path(os.readlink(f"/proc/{owner.pid}/exe")).is_relative_to(
            self.base / "codex/packages"
        )
        validate_incarnation(owner)
        os.kill(owner.pid, signal.SIGKILL)
        time.sleep(1)
        failed = self.snapshot()
        saved = next(row for row in failed["sessions"] if row["identity"] == ref)
        assert failed["sourceHealth"] == "partial"
        assert failed["sources"][0]["coverage"]["runtime"]["status"] == "unavailable"
        assert saved["runtime"]["value"] == saved["phase"]["value"] == "unknown"
        assert saved["activity"]["at"] == at
        try:
            self.handoff(ref)
        except RuntimeError as exc:
            assert str(exc) == "resume_evidence_unavailable"
        else:
            raise RuntimeError("offline_saved_resume_not_rejected")
        created = self.spawn(self.handoff())
        self.pause(created, 5)
        self.assert_native_client(created)
        recovered = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert (recovered.pid, recovered.start_ticks) != (owner.pid, owner.start_ticks)
        resumed = self.spawn(self.handoff(ref))
        self.pause(resumed, 4)
        self.assert_native_client(resumed)
        assert self.row(ref)["activity"]["at"] == at
        self.stop(resumed)
        self.stop(created)
        return {
            "status": "accepted",
            "hostScope": self.host,
            "provider": "codex",
            "independentOfFrontend": True,
            "ownedDaemonFailureVisible": True,
            "independentSavedDiscoverySurvivesFailure": True,
            "offlineSavedResumeRejected": True,
            "publicNewRestartsRuntime": True,
            "exactSavedResumeAfterRecovery": True,
            "recoveryPreservesConversationAge": True,
            "offlineSavedResumeDirectly": "unsupported",
            "terminalOutputPersisted": False,
        }

    def claude_partial(self):
        assert self.provider == "claude"
        source = next(
            row
            for row in self.snapshot()["sessions"]
            if row["job"]
            and row["job"]["state"] == "done"
            and row["worker"]["value"] == "present"
            and row["activity"]["at"] is not None
        )
        ref, at = source["identity"], source["activity"]["at"]
        sibling = self.handoff()
        sibling_ref = sibling["resultingIdentity"]
        job_path = next(
            path
            for path in (self.base / "claude/jobs").glob("*/state.json")
            if json.loads(path.read_text()).get("sessionId") == sibling_ref["nativeId"]
        )
        job_path.unlink()
        snapshot = self.snapshot()
        assert snapshot["sourceHealth"] == "partial"
        healthy = self.spawn(self.handoff(ref))
        self.pause(healthy, 3)
        self.assert_native_client(healthy)
        self.stop(healthy)
        for path in (self.base / "claude/sessions").glob("*.json"):
            registry = json.loads(path.read_text())
            if registry.get("sessionId") != ref["nativeId"]:
                continue
            pid = registry["pid"]
            assert (
                Path(f"/proc/{pid}/exe").resolve() == Path("/opt/claude-code/bin/claude").resolve()
            )
            assert ("CLAUDE_CONFIG_DIR=" + str(self.base / "claude")).encode() in Path(
                f"/proc/{pid}/environ"
            ).read_bytes().split(b"\0")
            os.kill(pid, signal.SIGKILL)
            break
        else:
            raise RuntimeError("owned_worker_unavailable")
        time.sleep(1)
        copied = self.handoff(ref)
        new_ref = copied["resultingIdentity"]
        assert new_ref is not None and new_ref != ref
        assert copied["requestedIdentity"] == ref
        new_row = self.row(new_ref)
        # Claude hydrates history in memory before persisting the copied store.
        # Native resumeSessionId already names the new ID, not its origin. Do
        # not infer an inherited clock or collapse the two native identities.
        assert new_row["activity"]["at"] is None or new_row["activity"]["at"] == at
        resumed = self.spawn(copied)
        self.pause(resumed, 3)
        self.assert_native_client(resumed)
        os.write(resumed[1], b"Reply only with OK.\r")
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            self.pause(resumed, 0.3)
            advanced = self.row(new_ref)
            if advanced["activity"]["at"] is not None and advanced["activity"]["at"] > at:
                break
        else:
            raise RuntimeError("copied_activity_pending")
        assert advanced["history"] is not None
        self.stop(resumed)
        return {
            "status": "accepted",
            "hostScope": self.host,
            "provider": "claude",
            "independentOfFrontend": True,
            "fixture": "native_worker_missing_job_metadata",
            "healthyLiveAttachThroughPartialFeed": True,
            "savedResumeThroughPartialFeed": True,
            "nativeCopiedIdentityExplicit": True,
            "savedResumeClockUnknownUntilNativePersistence": True,
            "firstNewPromptAdvancesCopiedActivity": True,
            "terminalOutputPersisted": False,
        }

    def claude_mixed(self):
        assert self.provider == "claude"
        old = self.root / "claude-2.1.287"
        assert hashlib.sha256(old.read_bytes()).hexdigest() == CLAUDE_PREVIOUS.sha256
        # An old launcher connected to a current daemon creates a current worker.
        # Model the actual upgrade: start an old runtime while its image is the
        # installed path in this private mount namespace, then reveal the new
        # installed image. Ordinary package bytes are never written.
        registries = list((self.base / "claude/sessions").glob("*.json"))
        if registries:
            assert len(registries) == 1
            registry = json.loads(registries[0].read_text())
            assert inspect_process(registry["pid"], "claude").artifact == CLAUDE_PREVIOUS
            ref = next(r["identity"] for r in self.snapshot()["sessions"]
                       if r["identity"]["nativeId"] == registry["sessionId"])
        else:
            subprocess.run(["mount", "--bind", str(old), "/opt/claude-code/bin/claude"], check=True)
            try:
                created = self.handoff()
                ref = created["resultingIdentity"]
                registry = next(
                    json.loads(p.read_text()) for p in (self.base / "claude/sessions").glob("*.json")
                    if json.loads(p.read_text()).get("sessionId") == ref["nativeId"]
                )
                assert inspect_process(registry["pid"], "claude").artifact == CLAUDE_PREVIOUS
            finally:
                # Detach this private bind while old workers retain their open image.
                subprocess.run(["umount", "-l", "/opt/claude-code/bin/claude"], check=True)
        assert not Path(f"/proc/{registry['pid']}/exe").samefile("/opt/claude-code/bin/claude")
        viewer = self.spawn(self.handoff(ref))
        self.pause(viewer, 10)
        self.assert_native_client(viewer)
        os.write(viewer[1], b"Reply only with OK.\r")
        working_seen = False
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            self.pause(viewer, 0.2)
            row = self.row(ref)
            working_seen |= row["phase"]["value"] == "working"
            if row["phase"]["value"] == "waiting" and row["activity"]["at"] is not None:
                break
        else:
            raise RuntimeError("mixed_turn_pending")
        self.stop(viewer)
        return {
            "status": "accepted", "hostScope": self.host, "provider": "claude",
            "workerVersion": "2.1.287", "viewerVersion": "2.1.289",
            "differentVerifiedImages": True, "oldWorkerObservedRunning": True,
            "currentViewerAttachesOldWorker": True, "sameNativeIdentity": True,
            "workingObserved": working_seen, "completedTurnWaiting": True,
            "terminalOutputPersisted": False,
        }

    def claude_approval(self):
        assert self.provider == "claude"
        settings = self.base / "claude/settings.json"
        original = settings.read_bytes()
        private = json.loads(original)
        private["permissions"] = {"ask": ["Bash", "Write"]}
        settings.write_text(json.dumps(private))
        created = self.handoff()
        ref = created["resultingIdentity"]
        viewer = self.spawn(created)
        self.pause(viewer, 10)
        self.assert_native_client(viewer)
        os.write(viewer[1], b"\x1b[200~Use Bash to write OK to approval-proof.txt.\x1b[201~\r")
        deadline = time.monotonic() + 60
        working_seen = False
        while time.monotonic() < deadline:
            self.pause(viewer, 0.2)
            row = self.row(ref)
            working_seen |= row["phase"]["value"] == "working"
            registry = next(
                (json.loads(p.read_text()) for p in (self.base / "claude/sessions").glob("*.json")
                 if json.loads(p.read_text()).get("sessionId") == ref["nativeId"]), None,
            )
            job = row["nativeIds"]["jobId"]
            state = json.loads((self.base / "claude/jobs" / job / "state.json").read_text())
            cues = self.output_cues.get(viewer[0], set())
            permission_cue = bool(cues & {"do you want to proceed?", "allow this command?", "do you want to allow"})
            if registry and (
                registry.get("waitingFor") == "permission prompt" or permission_cue
            ) and row["phase"]["value"] == "blocked" and row["blockedReason"] == "approval":
                break
        else:
            raise RuntimeError("native_approval_pending")
        assert not (self.base / "workspace/approval-proof.txt").exists()
        native_state, native_tempo = state.get("state"), state.get("tempo")
        assert native_state in {"working", "blocked"} and native_tempo in {"active", "blocked"}
        assert row["runtime"]["value"] == "running"
        assert row["phase"]["value"] == "blocked" and row["blockedReason"] == "approval"
        self.pause(viewer, 0.5)
        repeated = self.row(ref)
        assert repeated["activity"]["at"] == row["activity"]["at"]
        self.stop(viewer)
        settings.write_bytes(original)
        return {
            "status": "accepted", "hostScope": self.host, "provider": "claude",
            "version": "2.1.289", "workingObserved": working_seen,
            "nativePermissionPromptObserved": True,
            "nativeJobState": native_state, "nativeJobTempo": native_tempo,
            "observedPhase": row["phase"]["value"],
            "heldApprovalPreservesAge": True, "toolNotExecuted": True,
            "approvalAutomaticallyAnswered": False, "terminalOutputPersisted": False,
        }

    def claude_companion(self):
        assert self.provider == "claude"
        source = next(r for r in self.snapshot()["sessions"] if r["history"] and r["activity"]["at"])
        ref, at = source["identity"], source["activity"]["at"]
        companion_dir = self.base / "claude/projects/controlled-worktree-companion"
        companion_dir.mkdir(mode=0o700)
        companion = companion_dir / (ref["nativeId"] + ".jsonl")
        companion.write_text(json.dumps({
            "type": "custom-title", "sessionId": ref["nativeId"], "customTitle": "Companion only",
        }) + "\n")
        good = self.row(ref)
        assert good["title"] == source["title"] and good["activity"]["at"] == at
        assert len([r for r in self.snapshot()["sessions"] if r["identity"] == ref]) == 1
        companion.write_text(json.dumps({
            "type": "user", "sessionId": ref["nativeId"], "timestamp": "2026-10-01T00:00:00Z",
        }) + "\n")
        conflict = self.snapshot()
        assert not any(r["identity"] == ref and r["history"] for r in conflict["sessions"])
        assert "history_ambiguous" in conflict["sources"][0]["errors"]
        companion.unlink()
        companion_dir.rmdir()
        restored = self.row(ref)
        assert restored["activity"]["at"] == at
        return {
            "status": "accepted", "hostScope": self.host, "provider": "claude",
            "fixture": "native_transcript_with_controlled_metadata_companion",
            "singleConversationRetained": True, "companionRecencyIgnored": True,
            "titleAndNativeActivityPreserved": True, "conflictingConversationsExplicit": True,
            "restorationPreservesAge": True, "terminalOutputPersisted": False,
        }

    def rejection(self):
        assert self.provider == "codex"
        result = self.handoff()
        config = self.base / "codex/config.toml"
        original = config.read_bytes()
        try:
            config.write_bytes(original + b"\n# Private guard rejection proof\n")
            viewer = self.spawn(result)
            output = bytearray()
            deadline = time.monotonic() + 15
            status = None
            while time.monotonic() < deadline:
                if select.select([viewer[1]], [], [], 0.1)[0]:
                    try:
                        output.extend(os.read(viewer[1], 8192))
                    except OSError:
                        pass
                assert len(output) < 16384
                pid, value = os.waitpid(viewer[0], os.WNOHANG)
                if pid:
                    status = os.waitstatus_to_exitcode(value)
                    self.clients.remove(viewer)
                    os.close(viewer[1])
                    break
            assert status == 2
            assert json.loads(output.decode().strip()) == {
                "schemaVersion": 1, "error": "handoff_context_changed",
            }
        finally:
            config.write_bytes(original)
        return {
            "status": "accepted", "hostScope": self.host, "provider": "codex",
            "realPTY": True, "rejectionVisible": True, "reason": "handoff_context_changed",
            "nativeProviderNotExecuted": True, "terminalOutputPersisted": False,
        }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("codex", "claude"), required=True)
    parser.add_argument("--scenario", choices=("entry", "recovery", "partial", "mixed", "approval", "companion", "rejection"), default="entry")
    arguments = parser.parse_args()
    proof = Proof(arguments.provider)
    try:
        result = {"entry": proof.run, "recovery": proof.recovery, "partial": proof.claude_partial,
                  "mixed": proof.claude_mixed, "approval": proof.claude_approval,
                  "companion": proof.claude_companion, "rejection": proof.rejection}[
            arguments.scenario
        ]()
    finally:
        for client in list(proof.clients):
            proof.stop(client)
    (
        proof.root / ("native-" + proof.provider + "-" + arguments.scenario + "-acceptance.json")
    ).write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
