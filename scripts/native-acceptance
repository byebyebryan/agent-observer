#!/usr/bin/env python3
"""Explicit operator proof inside native-isolation; discards all terminal output."""

import argparse
import fcntl
import hashlib
import json
import os
import pty
import select
import signal
import struct
import subprocess
import termios
import time
from pathlib import Path

from agent_observer import codex_transport
from agent_observer.codex_endpoint import inspect_managed_endpoint, validate_incarnation
from agent_observer.codex_transport import PassiveClient


class Proof:
    def __init__(self, provider):
        self.root = Path(os.environ["NATIVE_PROOF_ROOT"])
        self.host = os.environ["NATIVE_PROOF_HOST"]
        self.base = self.root / ("native-" + self.host)
        if provider != "codex":
            raise ValueError("unsupported_provider")
        self.provider = provider
        self.clients = []
        self.output_cues = {}
        self.ready = json.loads((self.root / "ready.json").read_text())
        assert os.getuid() == 0 and all(self.ready.values())
        assert Path(os.environ["HOME"]) == self.base / "home"
        assert Path(os.environ["CODEX_HOME"]) == self.base / "codex"
        assert Path(os.environ["CLAUDE_CONFIG_DIR"]) == self.base / "claude"
        os.chdir(self.base / "workspace")

    def command(self, argv):
        process = subprocess.run(argv, capture_output=True, timeout=40)
        if process.returncode:
            try:
                payload = json.loads(process.stderr or process.stdout)
                code = payload.get("error", payload.get("reason"))
                if isinstance(code, str) and len(code) <= 128 and code.replace("_", "").isalnum():
                    raise RuntimeError(code)
            except (ValueError, KeyError, TypeError):
                pass
            raise RuntimeError("public_command_failed")
        return json.loads(process.stdout)

    def snapshot(self):
        return self.command(
            ["agent-observer", "snapshot", "--host-scope", self.host, "--provider", self.provider]
        )

    def row(self, ref):
        return next(row for row in self.snapshot()["sessions"] if row["identity"] == ref)

    def handoff(self, ref=None):
        request = {
            "schemaVersion": 2,
            "operation": "resume" if ref else "new",
            "hostScope": self.host,
            "provider": self.provider,
            "configHome": str(self.base / self.provider),
            "configHomeKind": "explicit",
            "cwd": str(self.base / "workspace"),
            "reference": ref,
        }
        plan = self.command(
            ["agent-observer-write", "prepare", "--request-json", json.dumps(request)]
        )
        result = self.command(["agent-observer-write", "execute", "--plan-json", json.dumps(plan)])
        assert result["handoff"] is not None
        return result

    def spawn(self, result):
        pid, fd = pty.fork()
        if pid == 0:
            os.execvp(
                "agent-observer-write",
                ["agent-observer-write", "enter", "--plan-json", json.dumps(result["handoff"])],
            )
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))
        os.set_blocking(fd, False)
        client = (pid, fd)
        self.clients.append(client)
        return client

    def pause(self, client, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            fd = client[1]
            for _ in range(16):
                if not select.select([fd], [], [], 0)[0]:
                    break
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                cues = self.output_cues.setdefault(client[0], set())
                lowered = data.lower()
                for cue in (b"already attached", b"connection refused", b"handoff_context_changed", b"resume_evidence_unavailable", b"unsupported_resume_route", b"native_launch_uncertain", b"do you want to proceed?", b"allow this command?", b"do you want to allow"):
                    if cue in lowered:
                        cues.add(cue.decode())
                if b"\x1b[6n" in data:
                    os.write(fd, b"\x1b[1;1R")
                if b"\x1b[c" in data:
                    os.write(fd, b"\x1b[?1;2c")
            time.sleep(0.1)

    def stop(self, client):
        try:
            os.kill(client[0], signal.SIGHUP)
        except ProcessLookupError:
            pass
        os.waitpid(client[0], 0)
        os.close(client[1])
        self.clients.remove(client)

    def assert_native_client(self, client):
        expected = Path("/opt/openai-codex/bin/codex")
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            state = Path(f"/proc/{client[0]}/stat").read_text().rsplit(")", 1)[1].split()[0]
            if state == "Z":
                raise RuntimeError("native_client_exited:" + ",".join(sorted(self.output_cues.get(client[0], set()))))
            if Path(f"/proc/{client[0]}/exe").resolve() == expected.resolve():
                self.pause(client, 2)
                return
            self.pause(client, 0.2)
        raise RuntimeError("native_client_not_entered")

    def codex_metadata(self, ref, *, rename=False, touch=False, name="Activity proof renamed"):
        owner = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert Path(os.readlink(f"/proc/{owner.pid}/exe")).is_relative_to(
            self.base / "codex/packages"
        )
        with PassiveClient.connect(
            owner.endpoint, expected_uid=owner.uid, expected_pid=owner.pid
        ) as client:
            assert client.initialize()["codexHome"] == str(self.base / "codex")
            before = client.loaded_threads()["data"]
            if rename:
                allowed = codex_transport._READ_METHODS
                codex_transport._READ_METHODS = allowed | {"thread/name/set"}
                try:
                    client._request(
                        "thread/name/set",
                        {"threadId": ref["nativeId"], "name": name},
                    )
                finally:
                    codex_transport._READ_METHODS = allowed
            metadata = client.latest_turn(ref["nativeId"])
            if touch:
                path = Path(client.read_thread(ref["nativeId"])["thread"]["path"])
                assert path.is_relative_to(self.base / "codex")
                if path.exists():
                    os.utime(path, None)
            assert before == client.loaded_threads()["data"]
        validate_incarnation(owner)
        return metadata

    def run(self):
        prior = {row["identity"]["nativeId"] for row in self.snapshot()["sessions"]}
        created = self.handoff()
        client = self.spawn(created)
        self.pause(client, 5)
        self.assert_native_client(client)
        rows = self.snapshot()["sessions"]
        ref = next(row["identity"] for row in rows if row["identity"]["nativeId"] not in prior)
        self.accepted_ref = ref
        empty = self.row(ref)
        assert empty["activity"]["at"] is None and empty["runtime"]["value"] == "running"
        os.write(client[1], b"Reply only with OK.\r")
        if self.provider == "codex":
            self.pause(client, 1)
            os.write(client[1], b"\r")
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            self.pause(client, 0.3)
            row = self.row(ref)
            if row["phase"]["value"] == "waiting" and row["activity"]["at"] is not None:
                break
        else:
            raise RuntimeError("native_turn_pending")
        at = row["activity"]["at"]
        if self.provider == "codex":
            turn = self.codex_metadata(ref)["data"][0]
            assert turn["items"] == [] and turn["itemsView"] == "notLoaded"
            assert turn["completedAt"] * 1000 == at
            self.codex_metadata(ref, rename=True, touch=True)
        renamed = self.row(ref)
        assert renamed["activity"]["at"] == at
        assert renamed["title"] == "Activity proof renamed"
        self.stop(client)
        resumed = self.spawn(self.handoff(ref))
        self.pause(resumed, 4)
        assert self.row(ref)["activity"]["at"] == at
        self.assert_native_client(resumed)
        repeated = self.spawn(self.handoff(ref))
        self.pause(repeated, 6)
        self.assert_native_client(repeated)
        assert self.row(ref)["activity"]["at"] == at
        self.stop(repeated)
        self.stop(resumed)
        return {
            "status": "accepted",
            "hostScope": self.host,
            "provider": self.provider,
            "isolation": self.ready,
            "independentOfFrontend": True,
            "emptyActivityUnknown": True,
            "nativeConversationActivity": True,
            "readsRenameHousekeepingPreserveAge": True,
            "savedOrLiveResumeExactIdentity": True,
            "resumePreservesAge": True,
            "repeatedNativeEntry": True,
            "terminalOutputPersisted": False,
        }

    def recovery(self):
        assert self.provider == "codex"
        ref = next(
            row["identity"]
            for row in self.snapshot()["sessions"]
            if row["activity"]["at"] is not None
        )
        at = self.row(ref)["activity"]["at"]
        owner = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert Path(os.readlink(f"/proc/{owner.pid}/exe")).is_relative_to(
            self.base / "codex/packages"
        )
        validate_incarnation(owner)
        daemon_executable = Path(os.readlink(f"/proc/{owner.pid}/exe"))
        os.kill(owner.pid, signal.SIGKILL)
        time.sleep(1)
        # Exercise direct reads even when this proof's normal backend is the
        # cache. Only explicit New may start the private replacement daemon.
        for _ in range(3):
            direct = self.command(
                ["agent-observer", "snapshot", "--host-scope", self.host, "--provider", "codex"]
            )
            assert not direct["sessions"] and direct["sourceHealth"] == "unavailable"
            assert direct["sources"][0]["coverage"]["runtime"]["status"] == "unavailable"
            for path in Path("/proc").glob("[0-9]*/exe"):
                try:
                    executable = Path(os.readlink(path))
                except OSError:
                    continue
                assert executable != daemon_executable
        failed = self.snapshot()
        saved = next((row for row in failed["sessions"] if row["identity"] == ref), None)
        assert failed["sourceHealth"] in {"partial", "unavailable"}
        assert failed["sources"][0]["coverage"]["runtime"]["status"] == "unavailable"
        if saved is not None:
            assert saved["runtime"]["value"] == saved["phase"]["value"] == "unknown"
            assert saved["activity"].get("lastKnownAt", saved["activity"]["at"]) == at
        else:
            assert not failed["sessions"]
        try:
            self.handoff(ref)
        except RuntimeError as exc:
            assert str(exc) == "resume_evidence_unavailable"
        else:
            raise RuntimeError("offline_saved_resume_not_rejected")
        created = self.spawn(self.handoff())
        self.pause(created, 5)
        self.assert_native_client(created)
        recovered = inspect_managed_endpoint(
            self.base / "codex"
        )
        assert (recovered.pid, recovered.start_ticks) != (owner.pid, owner.start_ticks)
        resumed = self.spawn(self.handoff(ref))
        self.pause(resumed, 4)
        self.assert_native_client(resumed)
        assert self.row(ref)["activity"]["at"] == at
        self.stop(resumed)
        self.stop(created)
        return {
            "status": "accepted",
            "hostScope": self.host,
            "provider": "codex",
            "independentOfFrontend": True,
            "ownedDaemonFailureVisible": True,
            "directUnavailableReads": 3,
            "directReadsStartedNoDaemon": True,
            "cachedSavedMetadataSurvivesFailure": saved is not None,
            "privateSavedStoreFallback": False,
            "offlineSavedResumeRejected": True,
            "publicNewRestartsRuntime": True,
            "exactSavedResumeAfterRecovery": True,
            "recoveryPreservesConversationAge": True,
            "reference": ref,
            "conversationActivityAt": at,
            "offlineSavedResumeDirectly": "unsupported",
            "terminalOutputPersisted": False,
        }


    def rejection(self):
        assert self.provider == "codex"
        result = self.handoff()
        config = self.base / "codex/config.toml"
        original = config.read_bytes()
        try:
            config.write_bytes(original + b"\n# Private guard rejection proof\n")
            viewer = self.spawn(result)
            output = bytearray()
            deadline = time.monotonic() + 15
            status = None
            while time.monotonic() < deadline:
                if select.select([viewer[1]], [], [], 0.1)[0]:
                    try:
                        output.extend(os.read(viewer[1], 8192))
                    except OSError:
                        pass
                assert len(output) < 16384
                pid, value = os.waitpid(viewer[0], os.WNOHANG)
                if pid:
                    status = os.waitstatus_to_exitcode(value)
                    self.clients.remove(viewer)
                    os.close(viewer[1])
                    break
            assert status == 2
            assert json.loads(output.decode().strip()) == {
                "schemaVersion": 2, "error": "handoff_context_changed",
            }
        finally:
            config.write_bytes(original)
        return {
            "status": "accepted", "hostScope": self.host, "provider": "codex",
            "realPTY": True, "rejectionVisible": True, "reason": "handoff_context_changed",
            "nativeProviderNotExecuted": True, "terminalOutputPersisted": False,
        }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("codex",), required=True)
    parser.add_argument("--scenario", choices=("entry", "recovery", "rejection"), default="entry")
    arguments = parser.parse_args()
    proof = Proof(arguments.provider)
    try:
        result = {"entry": proof.run, "recovery": proof.recovery,
                  "rejection": proof.rejection}[arguments.scenario]()
    finally:
        for client in list(proof.clients):
            proof.stop(client)
    (
        proof.root / ("native-" + proof.provider + "-" + arguments.scenario + "-acceptance.json")
    ).write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
