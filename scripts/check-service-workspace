#!/usr/bin/env python3
"""Installed workspace parity against independent local Git metadata commands.

Ordinary provider reads only. No Observer imports or persisted provider payloads.
An explicit socket reads an existing publisher; otherwise own a disposable one.
"""

import argparse
import json
import os
import signal
import subprocess
import time
from pathlib import Path

MAX_FRAME = 8 * 1024 * 1024 + 16384


def run(argv, timeout=30):
    result = subprocess.run(argv, capture_output=True, timeout=timeout, cwd="/tmp")
    if result.returncode or len(result.stdout) > MAX_FRAME:
        raise ValueError("workspace_command_failed")
    return json.loads(result.stdout)


def reference(cwd, config):
    if cwd is None or not Path(cwd).is_dir():
        return None
    path = str(Path(cwd).resolve(strict=True))
    roots = [(str(Path(r["path"]).resolve()), r["key"]) for r in config["roots"]
             if Path(r["path"]).is_dir()]
    matches = [(root, key) for root, key in roots if path == root or path.startswith(root + "/")]
    root, key = max(matches, key=lambda pair: len(pair[0])) if matches else (None, None)
    relative = path[len(root) + 1:] or "." if root and path != root else "." if root else None
    projects = [p for p in config["projects"] if p["rootKey"] == key and relative is not None
                and (p["relativePath"] == "." or relative == p["relativePath"]
                     or relative.startswith(p["relativePath"].rstrip("/") + "/"))]
    project = max(projects, key=lambda p: len(p["relativePath"]))["projectKey"] if projects else None
    git = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false",
                          "-c", "core.hooksPath=/dev/null", "-C", path, "rev-parse",
                          "--path-format=absolute", "--show-toplevel", "--git-common-dir"],
                         capture_output=True, timeout=5)
    repo = None
    if not git.returncode:
        if len(git.stdout) > 16384:
            raise ValueError("workspace_git_reference_limit")
        lines = git.stdout.decode("utf-8", "strict").splitlines()
        if len(lines) != 2:
            raise ValueError("workspace_git_reference_ambiguous")
        repo_root, common = (str(Path(p).resolve(strict=True)) for p in lines)
        repo = {"root": repo_root, "commonDir": common,
                "relativePath": os.path.relpath(path, repo_root)}
    return {"root": root, "rootKey": key, "relativePath": relative,
            "projectKey": project, "repo": repo}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", type=Path, required=True)
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--host-scope", required=True)
    parser.add_argument("--provider", action="append", choices=("codex", "claude"), required=True)
    parser.add_argument("--workspace-config", type=Path, required=True)
    parser.add_argument("--socket", type=Path)
    args = parser.parse_args()
    if args.root.resolve(strict=True) != args.root or args.root.stat().st_uid != os.getuid():
        raise ValueError("workspace_proof_scope")
    config = json.loads(args.workspace_config.read_bytes())
    path = args.socket or args.root / "ipc/read.sock"
    cli = args.prefix / "bin/agent-observer"
    service = None
    try:
        if args.socket is None:
            argv = [str(args.prefix / "bin/agent-observer-service"), "serve",
                    "--host-scope", args.host_scope, "--socket", str(path),
                    "--workspace-config", str(args.workspace_config)]
            for provider in args.provider:
                argv += ["--provider", provider]
            service = subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       start_new_session=True, cwd="/tmp")
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            try:
                frame = run([str(cli), "service", "snapshot", "--host-scope", args.host_scope,
                             "--socket", str(path)])
                if frame["snapshot"] is not None and all(c["accepted"] for s in frame["sources"] for c in s["components"]):
                    break
            except (OSError, ValueError):
                pass
            time.sleep(0.1)
        else:
            raise ValueError("workspace_service_warming")
        argv = [str(cli), "snapshot", "--host-scope", args.host_scope,
                "--workspace-config", str(args.workspace_config)]
        for provider in args.provider:
            argv += ["--provider", provider]
        direct = run(argv)
        cached = run([str(cli), "service", "snapshot", "--host-scope", args.host_scope,
                      "--socket", str(path)])
        def key(row):
            return tuple(row["identity"][k] for k in ("hostScope", "provider", "namespace", "nativeIdKind", "nativeId"))
        before = {key(r): r for r in direct["sessions"]}
        after = {key(r): r for r in cached["snapshot"]["sessions"]}
        matches = unavailable = mapped = changed = 0
        for identity in before.keys() & after.keys():
            a, b = before[identity], after[identity]
            if a["cwd"] != b["cwd"]:
                changed += 1
                continue
            expected = reference(a["cwd"], config)
            for row in (a, b):
                observed = row["workspace"]
                if expected is None:
                    if observed is None or observed["health"] != "unavailable":
                        raise ValueError("workspace_unavailable_mismatch")
                elif observed is None or observed["health"] != "current" or any(observed[k] != v for k, v in expected.items()):
                    raise ValueError("workspace_reference_mismatch")
            if a["workspace"] != b["workspace"]:
                raise ValueError("workspace_direct_service_mismatch")
            matches += 1
            unavailable += expected is None
            mapped += expected is not None and expected["projectKey"] is not None
        if not matches or not mapped:
            raise ValueError("workspace_mapping_unexercised")
        receipt = {"status": "accepted", "hostScope": args.host_scope, "prefix": str(args.prefix),
                   "serviceProtocol": 1, "serviceId": cached["serviceId"],
                   "matchedIdentities": matches, "unavailableCwds": unavailable,
                   "explicitlyMappedRows": mapped, "changedCwds": changed,
                   "directOnlyRows": len(before.keys() - after.keys()),
                   "serviceOnlyRows": len(after.keys() - before.keys()),
                   "independentGitReference": "git_rev_parse_read_only", "importsObserver": False,
                   "ordinaryProviderActions": False, "ownedPublisher": service is not None}
        (args.root / "workspace-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt))
    finally:
        if service is not None:
            if service.poll() is None:
                service.send_signal(signal.SIGTERM)
            service.wait(timeout=15)
            if path.exists():
                raise ValueError("workspace_owned_socket_cleanup")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        print(json.dumps({"status": "rejected", "reason": "workspace_proof_failed"}))
        raise SystemExit(2) from None
