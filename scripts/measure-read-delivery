#!/usr/bin/env python3
"""Bounded ordinary-host resource windows; no provider imports or raw payloads.

Managed roots are selected from systemd MainPID; UID and start ticks are checked
at every sample.
Reader processes are created here and stopped here. CPU includes reaped child
ticks plus live descendant ticks; process/FD/memory observations are sampled.
Remote SSH server/bridge costs are excluded, not silently attributed locally.
"""

import argparse
import json
import os
import signal
import subprocess
import time
from pathlib import Path


def counters(pid):
    node = Path(f"/proc/{pid}")
    if node.stat().st_uid != os.geteuid():
        raise ValueError("measurement_uid")
    fields = (node / "stat").read_text().rsplit(")", 1)[1].split()
    result = {"birth": int(fields[19]), "parent": int(fields[1]),
              "ticks": sum(int(fields[i]) for i in (11, 12, 13, 14)),
              "rss": int((node / "statm").read_text().split()[1]) * os.sysconf("SC_PAGE_SIZE"),
              "fds": len(list((node / "fd").iterdir())), "pss": None}
    try:
        for line in (node / "smaps_rollup").read_text().splitlines():
            if line.startswith("Pss:"):
                result["pss"] = int(line.split()[1]) * 1024
    except OSError:
        pass
    result["children"] = [int(p) for p in (node / "task" / str(pid) / "children").read_text().split()]
    if int((node / "stat").read_text().rsplit(")", 1)[1].split()[19]) != result["birth"]:
        raise ValueError("measurement_incarnation")
    return result


def tree(pid, birth):
    pending, rows, seen = [(pid, None)], [], set()
    while pending:
        current, parent = pending.pop()
        if current in seen or len(seen) >= 128:
            raise ValueError("measurement_tree_bound")
        seen.add(current)
        try:
            row = counters(current)
        except OSError:
            if current == pid:
                raise
            continue
        if current == pid and row["birth"] != birth or parent is not None and row["parent"] != parent:
            raise ValueError("measurement_incarnation")
        rows.append(row)
        pending.extend((p, current) for p in row["children"])
    return {"ticks": sum(r["ticks"] for r in rows), "rssBytes": sum(r["rss"] for r in rows),
            "pssBytes": sum(r["pss"] for r in rows if r["pss"] is not None),
            "pssComplete": all(r["pss"] is not None for r in rows),
            "fds": sum(r["fds"] for r in rows), "processes": len(rows)}


def unit_root(unit):
    result = subprocess.run(["systemctl", "--user", "show", unit, "--property=MainPID", "--value"],
                            capture_output=True, check=True, text=True, timeout=5)
    pid = int(result.stdout.strip())
    return pid, counters(pid)["birth"]


def stop_owned(process):
    if process.poll() is None:
        process.send_signal(signal.SIGINT)
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=5)


def window(args, workload):
    processes = []
    roots = {"observer": unit_root("agent-observer.service"),
             "bridge": unit_root("mesh-plus-agent.service")}
    count = 0 if workload == "baseline" else 2 if workload == "fleet-two" else 1
    scope = "local" if workload == "local-one" else "fleet"
    started = time.monotonic()
    try:
        for number in range(count):
            process = subprocess.Popen([str(args.cli), "mesh", "watch", "--scope", scope],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       start_new_session=True)
            processes.append(process)
            roots[f"reader{number + 1}"] = (process.pid, counters(process.pid)["birth"])
        time.sleep(args.warmup)
        beginning = {role: tree(*root) for role, root in roots.items()}
        sums = {role: {key: 0 for key in ("rssBytes", "pssBytes", "fds", "processes")} for role in roots}
        peaks = {role: dict(values) for role, values in sums.items()}
        samples = 0
        begin = time.monotonic()
        while time.monotonic() - begin < args.duration:
            for process in processes:
                if process.poll() is not None:
                    raise ValueError("measurement_reader_exited")
            for role, root in roots.items():
                row = tree(*root)
                for key in sums[role]:
                    sums[role][key] += row[key]
                    peaks[role][key] = max(peaks[role][key], row[key])
            samples += 1
            time.sleep(1)
        ending = {role: tree(*root) for role, root in roots.items()}
        elapsed = time.monotonic() - begin
        result = {"workload": workload, "host": args.host, "addedReaders": count,
                  "scope": scope if count else None, "warmupSeconds": args.warmup,
                  "durationSeconds": round(elapsed, 3), "samples": samples,
                  "startupThroughWarmupSeconds": round(begin - started, 3),
                  "roles": {}, "ordinaryHost": True, "idleBenchmark": False,
                  "remoteSSHServerCostsIncluded": False, "rawPayloadsRetained": False}
        for role in roots:
            cpu = (ending[role]["ticks"] - beginning[role]["ticks"]) / os.sysconf("SC_CLK_TCK")
            result["roles"][role] = {
                "cpuSeconds": round(cpu, 3), "percentOneCore": round(cpu / elapsed * 100, 3),
                "mean": {key: round(value / samples) for key, value in sums[role].items()},
                "peak": peaks[role], "end": {key: ending[role][key] for key in sums[role]},
                "pssCompleteAtEnd": ending[role]["pssComplete"],
            }
        return result
    finally:
        for process in processes:
            stop_owned(process)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", choices=("snap", "starship"), required=True)
    parser.add_argument("--cli", type=Path, default=Path.home() / ".local/bin/agent-observer")
    parser.add_argument("--duration", type=int, default=600)
    parser.add_argument("--warmup", type=int, default=30)
    parser.add_argument("--workloads", nargs="+", choices=("baseline", "local-one", "fleet-one", "fleet-two"),
                        default=["baseline", "local-one", "fleet-one", "fleet-two"])
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 30 <= args.duration <= 1800 or not 0 <= args.warmup <= 60:
        parser.error("duration 30..1800 and warmup 0..60 required")
    results = []
    for workload in args.workloads:
        print(json.dumps({"measurement": workload, "host": args.host, "state": "started"}), flush=True)
        results.append(window(args, workload))
        args.output.write_text(json.dumps({"status": "measured", "windows": results,
                                           "limits": ["ordinary active hosts", "one-second tree sampling",
                                                      "remote SSH server/bridge excluded", "concurrent host workloads"]}, indent=2) + "\n")
        print(json.dumps({"measurement": workload, "host": args.host, "state": "complete"}), flush=True)


if __name__ == "__main__":
    main()
