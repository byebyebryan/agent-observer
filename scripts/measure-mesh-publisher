#!/usr/bin/env python3
"""Owned old/new cached publisher windows and independent installed CLI comparison."""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import signal
import subprocess
import tempfile
import time
from pathlib import Path


def stop(process):
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGINT)
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=3)


def resources():
    path = Path(__file__).with_name("measure-read-delivery")
    loader = importlib.machinery.SourceFileLoader("publisher_resource_counters", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def exercise(args):
    cost = resources()
    results, comparisons = [], []
    with tempfile.TemporaryDirectory(prefix="agent-publisher-cost-") as directory:
        root = Path(directory)
        config = root / "sources.toml"
        config.write_text(f'version=1\nhost={json.dumps(args.host_scope)}\n[sources.agent]\ndomain="agent"\nsocket={json.dumps(str(args.service_socket))}\n')
        config.chmod(0o600)
        for label, publisher_prefix, reader_cli in (
            ("baseline", args.baseline, args.baseline_cli),
            ("candidate", args.candidate, args.candidate / "bin/agent-observer"),
        ):
            endpoint = root / (label + ".sock")
            publisher = subprocess.Popen([str(publisher_prefix / "bin/mesh-plus"), "serve", "--source", "agent",
                                          "--config", str(config), "--socket", str(endpoint)],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            readers = []
            try:
                deadline = time.monotonic() + 10
                while not endpoint.exists():
                    if publisher.poll() is not None or time.monotonic() >= deadline:
                        raise ValueError("owned_publisher_startup")
                    time.sleep(.05)
                # Interoperate both reader generations with each publisher.
                for cli in (args.baseline_cli, args.candidate / "bin/agent-observer"):
                    output = subprocess.check_output([str(cli), "mesh", "snapshot", "--scope", "local",
                                                      "--local-host", args.host_scope, "--socket", str(endpoint)],
                                                     timeout=30, cwd="/tmp")
                    frame = json.loads(output)
                    if frame["mesh"]["status"] != "complete":
                        raise ValueError("owned_publisher_read")
                    comparisons.append({"publisher": label, "readerCli": str(cli),
                                        "rows": len(frame["sessions"]), "status": "complete"})
                if label == "candidate" and args.native_rounds:
                    evaluator = Path(__file__).with_name("evaluate-mesh")
                    output = subprocess.check_output(["python3", str(evaluator), "--host-scope", args.host_scope,
                                                      "--cli", str(reader_cli), "--socket", str(endpoint),
                                                      "--provider", "codex", "--rounds", str(args.native_rounds)],
                                                     timeout=300, cwd="/tmp")
                    (args.output.parent / (args.host_scope + "-a20-independent-native.json")).write_bytes(output)
                reader = subprocess.Popen([str(reader_cli), "mesh", "watch", "--scope", "local",
                                           "--local-host", args.host_scope, "--socket", str(endpoint)],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                readers.append(reader)
                roots = {"publisher": (publisher.pid, cost.counters(publisher.pid)["birth"]),
                         "reader": (reader.pid, cost.counters(reader.pid)["birth"])}
                time.sleep(args.warmup)
                before = {role: cost.tree(*identity) for role, identity in roots.items()}
                begin = time.monotonic()
                samples = []
                while time.monotonic() - begin < args.duration:
                    if publisher.poll() is not None or reader.poll() is not None:
                        raise ValueError("owned_publisher_exited")
                    samples.append({role: cost.tree(*identity) for role, identity in roots.items()})
                    time.sleep(1)
                elapsed = time.monotonic() - begin
                after = {role: cost.tree(*identity) for role, identity in roots.items()}
                report = {"publisher": label, "durationSeconds": round(elapsed, 3), "samples": len(samples), "roles": {}}
                for role in roots:
                    cpu = (after[role]["ticks"] - before[role]["ticks"]) / os.sysconf("SC_CLK_TCK")
                    report["roles"][role] = {"percentOneCore": round(cpu / elapsed * 100, 3),
                                             "cpuSeconds": round(cpu, 3),
                                             "peak": {key: max(s[role][key] for s in samples)
                                                      for key in ("pssBytes", "rssBytes", "fds", "processes")},
                                             "end": after[role]}
                results.append(report)
                args.output.write_text(json.dumps({"hostScope": args.host_scope, "windows": results,
                                                   "mixedReaders": comparisons,
                                                   "limits": ["ordinary host", "local one-reader windows",
                                                              "one-second sampling", "fleet and capacity separate"]}, indent=2) + "\n")
            finally:
                for reader in readers:
                    stop(reader)
                stop(publisher)
    return {"status": "measured", "hostScope": args.host_scope, "output": str(args.output),
            "ownedProcessesRetired": True, "normalServicesSelected": False}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host-scope", required=True)
    parser.add_argument("--candidate", type=Path, required=True)
    parser.add_argument("--baseline", type=Path, required=True)
    parser.add_argument("--baseline-cli", type=Path, required=True)
    parser.add_argument("--service-socket", type=Path, required=True)
    parser.add_argument("--duration", type=int, default=120)
    parser.add_argument("--warmup", type=int, default=10)
    parser.add_argument("--native-rounds", type=int, choices=(0, 1, 2), default=2)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 30 <= args.duration <= 1800 or not 0 <= args.warmup <= 60:
        parser.error("duration 30..1800 and warmup 0..60 required")
    if not all(p.is_absolute() for p in (args.candidate, args.baseline, args.baseline_cli, args.service_socket, args.output)):
        parser.error("absolute paths required")
    print(json.dumps(exercise(args), indent=2))


if __name__ == "__main__":
    main()
