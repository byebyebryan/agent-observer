#!/usr/bin/env python3
"""Install/verify an exact local wheel without selecting links or invoking providers."""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import zipfile
from pathlib import Path, PurePosixPath


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def active_feed_manifest(value):
    """Optional v5 extension; older manifests do not imply active support."""
    if "activeFeed" not in value:
        return None
    active = value["activeFeed"]
    if (
        type(value.get("manifestVersion")) is not int or value["manifestVersion"] != 5
        or not isinstance(active, dict)
        or set(active) != {"protocol", "schemas", "schemaSha256", "selectorDigest"}
        or type(active.get("protocol")) is not int or active["protocol"] != 1
        or not isinstance(active.get("schemas"), dict)
        or set(active["schemas"]) != {"request", "frame"}
        or any(type(version) is not int or version != 1 for version in active["schemas"].values())
        or not isinstance(active.get("schemaSha256"), dict)
        or set(active["schemaSha256"]) != {"request", "frame"}
        or any(not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value)
               for value in active["schemaSha256"].values())
        or not isinstance(active.get("selectorDigest"), str)
        or not re.fullmatch(r"sha256:[0-9a-f]{64}", active["selectorDigest"])
    ):
        raise ValueError("active_feed_manifest_invalid")
    return active


def document(path):
    if path.stat().st_size > 32768:
        raise ValueError("manifest_limit")
    value = json.loads(path.read_text())
    if (
        value.get("manifestVersion") not in {1, 2, 3, 4, 5, 6}
        or value.get("package") != "agent-observer"
        or not re.fullmatch(r"[0-9a-f]{64}", value.get("wheelSha256", ""))
        or not re.fullmatch(r"[0-9a-f]{40}", value.get("sourceRevision", ""))
        or value.get("entrypoints") != (
            ["agent-observer", "agent-observer-service"] if value.get("manifestVersion") == 6
            else ["agent-observer", "agent-observer-write"] if value.get("manifestVersion") == 1
            else ["agent-observer", "agent-observer-write", "agent-observer-service"])
        or value.get("manifestVersion") == 2 and value.get("service") != {"protocol": 1, "schemas": {"request": 1, "frame": 1}}
        or value.get("manifestVersion") == 2 and value.get("schemas") != {"snapshot": 3, "watch": 3, "write": 1}
        or value.get("manifestVersion") == 3 and (value.get("service") != {"protocol": 2, "schemas": {"request": 2, "frame": 2}} or value.get("write") != {"schema": 2} or value.get("apiVersion") != 2 or value.get("schemas") != {"snapshot": 4, "watch": 4})
        or value.get("manifestVersion") == 4 and (value.get("service") != {"protocol": 3, "schemas": {"request": 3, "frame": 3}} or value.get("write") != {"schema": 2} or value.get("apiVersion") != 3 or value.get("schemas") != {"snapshot": 5, "watch": 5})
        or value.get("manifestVersion") == 5 and (value.get("service") != {"protocol": 4, "schemas": {"request": 4, "frame": 4}} or value.get("write") != {"schema": 2} or value.get("apiVersion") != 4 or value.get("schemas") != {"snapshot": 6, "watch": 6})
        or value.get("manifestVersion") == 6 and (
            value.get("service") != {"protocol": 4, "schemas": {"request": 4, "frame": 4}}
            or value.get("apiVersion") != 4 or value.get("schemas") != {"snapshot": 6, "watch": 6}
            or value.get("retiredCapabilities") != ["write", "active-feed"]
            or "write" in value or "activeFeed" in value)
        or value.get("manifestVersion") == 1 and ("service" in value or "write" in value or value.get("schemas", {}).get("snapshot") in {4, 5, 6})
        or value.get("schemas") not in (
            {"snapshot": 2, "watch": 2, "write": 1},
            {"snapshot": 3, "watch": 3, "write": 1},
            {"snapshot": 4, "watch": 4},
            {"snapshot": 5, "watch": 5},
            {"snapshot": 6, "watch": 6},
        )
        or value.get("schemas", {}).get("snapshot") == 3 and value.get("apiVersion") != 1
    ):
        raise ValueError("manifest_invalid")
    active_feed_manifest(value)
    return value


def wheel_check(wheel, manifest):
    if wheel.name != manifest["wheel"] or digest(wheel) != manifest["wheelSha256"]:
        raise ValueError("wheel_mismatch")
    with zipfile.ZipFile(wheel) as archive:
        names = archive.namelist()
        if len(names) != len(set(names)) or len(names) > 4096:
            raise ValueError("wheel_entries_invalid")
        for name in names:
            path = PurePosixPath(name)
            if path.is_absolute() or ".." in path.parts or ".data" in name:
                raise ValueError("wheel_path_invalid")
    return manifest


def run(argv, timeout=30):
    output = subprocess.run(argv, capture_output=True, timeout=timeout, check=False)
    if output.returncode or len(output.stdout) > 1024 * 1024:
        raise ValueError("candidate_command_failed")
    return output.stdout


def verify_active_feed(prefix, site, active, api_version):
    """Compare installed public declarations with exact packaged schema bytes."""
    executable = str(prefix / "bin/agent-observer")
    interface = json.loads(run([executable, "service", "active-api"]))
    if (
        not isinstance(interface, dict)
        or type(interface.get("activeFeedProtocol")) is not int
        or interface["activeFeedProtocol"] != active["protocol"]
        or type(interface.get("observationApiVersion")) is not int
        or interface["observationApiVersion"] != api_version
        or not isinstance(interface.get("selector"), dict)
        or interface.get("selectorDigest") != active["selectorDigest"]
    ):
        raise ValueError("active_feed_api_mismatch")
    selector = json.dumps(interface["selector"], sort_keys=True, ensure_ascii=True,
                          allow_nan=False, separators=(",", ":")).encode()
    if "sha256:" + hashlib.sha256(selector).hexdigest() != active["selectorDigest"]:
        raise ValueError("active_feed_selector_mismatch")
    for kind in ("request", "frame"):
        path = site / "agent_observer" / "contracts" / f"active-{kind}.schema.json"
        if (not path.is_file() or path.is_symlink() or path.stat().st_size > 1024 * 1024
                or digest(path) != active["schemaSha256"][kind]):
            raise ValueError("active_feed_schema_bytes_mismatch")
        packaged = json.loads(path.read_bytes())
        declared = json.loads(run([executable, "service", "active-schema", "--kind", kind]))
        if not isinstance(packaged, dict) or not isinstance(packaged.get("properties"), dict):
            raise ValueError("active_feed_schema_mismatch")
        properties = packaged["properties"]
        binding = properties.get("activeFeedProtocol")
        protocol = binding.get("const") if isinstance(binding, dict) else None
        if (
            declared != packaged
            or type(protocol) is not int or protocol != active["protocol"]
            or packaged.get("$id") != f"urn:agent-observer:active-{kind}:{active['schemas'][kind]}"
            or properties.get("selector") != {"const": interface["selector"]}
            or properties.get("selectorDigest") != {"const": active["selectorDigest"]}
        ):
            raise ValueError("active_feed_schema_mismatch")
    return True


def verify(prefix, wheel, manifest, profile):
    active = active_feed_manifest(manifest)
    wheel_check(wheel, manifest)
    if prefix.resolve(strict=True) != prefix or prefix.stat().st_uid != os.geteuid():
        raise ValueError("prefix_ownership_invalid")
    code = """import importlib.metadata,json,sysconfig
from pathlib import Path
import agent_observer.contract as contract
try:
 sdk=importlib.metadata.distribution('claude-agent-sdk')
 sdk_version=sdk.version
 bundled=Path(sdk.locate_file('claude_agent_sdk/_bundled'))
 bundled_executable=any(p.name!='.gitignore' for p in bundled.rglob('*')) if bundled.exists() else False
except importlib.metadata.PackageNotFoundError:
 sdk_version=None;bundled_executable=False
retired=any(p.name.startswith(('claude_','_claude_')) for p in Path(contract.__file__).parent.glob('*.py'))
print(json.dumps({'version':importlib.metadata.version('agent-observer'),'site':sysconfig.get_path('purelib'),'module':contract.__file__,'sdk':sdk_version,'bundledExecutable':bundled_executable,'retiredNativeModules':retired}))"""
    metadata = json.loads(run([str(prefix / "bin/python"), "-I", "-B", "-c", code]))
    site = Path(metadata.pop("site"))
    if (
        metadata["version"] != manifest["version"]
        or not site.is_relative_to(prefix)
        or not Path(metadata.pop("module")).is_relative_to(site)
        or metadata["bundledExecutable"]
        or metadata["retiredNativeModules"]
        or metadata["sdk"] is not None
    ):
        raise ValueError("candidate_profile_mismatch")
    with zipfile.ZipFile(wheel) as archive:
        for entry in archive.infolist():
            if entry.is_dir() or entry.filename.endswith(".dist-info/RECORD"):
                continue
            target = site / entry.filename
            if (
                not target.is_file()
                or target.is_symlink()
                or target.read_bytes() != archive.read(entry)
            ):
                raise ValueError("installed_wheel_bytes_mismatch")
    for name in manifest["entrypoints"]:
        target = prefix / "bin" / name
        if not target.is_file() or not os.access(target, os.X_OK):
            raise ValueError("entrypoint_missing")
        first = target.read_bytes().splitlines()[0].decode()
        interpreter = Path(first[2:]) if first.startswith("#!") else Path("/")
        if (
            interpreter.parent != prefix / "bin"
            or not re.fullmatch(r"python(?:3(?:\.\d+)?)?", interpreter.name)
            or not interpreter.samefile(prefix / "bin/python")
        ):
            raise ValueError("entrypoint_prefix_mismatch")
    cli_version = run([str(prefix / "bin/agent-observer"), "--version"]).decode().strip()
    if cli_version != "agent-observer " + manifest["version"]:
        raise ValueError("cli_version_mismatch")
    for name in ("snapshot", "watch"):
        schema = json.loads(run([str(prefix / "bin/agent-observer"), "schema", "--kind", name]))
        if schema["properties"]["schemaVersion"] != {"const": manifest["schemas"][name]}:
            raise ValueError("schema_mismatch")
    if manifest["schemas"]["snapshot"] in {3, 4, 5, 6}:
        interface = json.loads(run([str(prefix / "bin/agent-observer"), "api"]))
        if interface.get("apiVersion") != manifest["apiVersion"] or interface.get("schemas") != manifest["schemas"]:
            raise ValueError("api_mismatch")
    for name in (() if manifest["manifestVersion"] == 6 else ("request", "plan", "result")):
        schema = json.loads(
            run([str(prefix / "bin/agent-observer-write"), "schema", "--kind", name])
        )
        if schema["properties"]["schemaVersion"] != {"const": (manifest["write"]["schema"] if manifest["manifestVersion"] in {3, 4, 5} else manifest["schemas"]["write"])}:
            raise ValueError("schema_mismatch")
    if manifest["manifestVersion"] in {2, 3, 4, 5, 6}:
        service = json.loads(run([str(prefix / "bin/agent-observer"), "service", "api"]))
        if service.get("serviceProtocol") != manifest["service"]["protocol"] or service.get("observationApiVersion") != manifest["apiVersion"] or service.get("embeddedSnapshotVersion") != manifest["schemas"]["snapshot"]:
            raise ValueError("service_api_mismatch")
        version = run([str(prefix / "bin/agent-observer-service"), "--version"]).decode().strip()
        if version != "agent-observer-service " + manifest["version"]:
            raise ValueError("service_version_mismatch")
        for kind, version in manifest["service"]["schemas"].items():
            schema = json.loads(run([str(prefix / "bin/agent-observer"), "service", "schema", "--kind", kind]))
            if schema["properties"]["serviceProtocol"] != {"const": version}:
                raise ValueError("service_schema_mismatch")
    if active is not None:
        verify_active_feed(prefix, site, active, manifest["apiVersion"])
    if manifest["manifestVersion"] == 6:
        retired = json.loads(run([str(prefix / "bin/python"), "-I", "-B", "-c", """import importlib.util,importlib.metadata,json
names=('write_client','write_contract','codex_exact','active_contract','active_feed','mesh_active_source','mesh_active_profile','mesh_active_read')
print(json.dumps({'modules':[name for name in names if importlib.util.find_spec('agent_observer.'+name) is not None],
'entrypoints':sorted(e.name for e in importlib.metadata.distribution('agent-observer').entry_points if e.group=='console_scripts')}))"""]))
        if (retired["modules"] or retired["entrypoints"] != ["agent-observer", "agent-observer-service"]
                or (prefix / "bin/agent-observer-write").exists()):
            raise ValueError("retired_capability_installed")
    return {
        "status": "accepted",
        "prefix": str(prefix),
        "wheelSha256": manifest["wheelSha256"],
        "sourceRevision": manifest["sourceRevision"],
        "profile": profile,
        **metadata,
        "installedWheelBytesVerified": True,
        "entrypointsVerified": True,
        "schemaVersionsVerified": True,
        **({"serviceProtocolVerified": True} if manifest["manifestVersion"] in {2, 3, 4, 5, 6} else {}),
        **({"retiredCapabilitiesVerified": True} if manifest["manifestVersion"] == 6 else {}),
        **({"activeFeedVerified": True} if active is not None else {}),
        "providerInvocations": 0,
        "selectedLinksChanged": False,
    }


def install(prefix, wheel, manifest, profile):
    active_feed_manifest(manifest)
    wheel_check(wheel, manifest)
    if prefix.exists():
        return verify(prefix, wheel, manifest, profile)
    parent = prefix.parent
    if (
        not prefix.is_absolute()
        or parent.resolve(strict=True) != parent
        or parent.stat().st_uid != os.geteuid()
        or prefix.is_symlink()
    ):
        raise ValueError("prefix_parent_invalid")
    prefix.mkdir(mode=0o700)
    identity = prefix.stat().st_dev, prefix.stat().st_ino
    try:
        run([sys.executable, "-m", "venv", str(prefix)], timeout=120)
        run(
            [
                str(prefix / "bin/pip"),
                "install",
                "--disable-pip-version-check",
                "--no-index",
                "--no-deps",
                str(wheel),
            ],
            timeout=120,
        )
        result = verify(prefix, wheel, manifest, profile)
        (prefix / "candidate-receipt.json").write_text(json.dumps(result, indent=2) + "\n")
        return result
    except BaseException:
        if not prefix.is_symlink() and (prefix.stat().st_dev, prefix.stat().st_ino) == identity:
            shutil.rmtree(prefix)
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("install", "verify"))
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--wheel", type=Path, required=True)
    parser.add_argument("--prefix", type=Path, required=True)
    parser.add_argument("--profile", choices=("core",), default="core")
    args = parser.parse_args()
    try:
        manifest = document(args.manifest)
        operation = install if args.command == "install" else verify
        print(json.dumps(operation(args.prefix, args.wheel, manifest, args.profile)))
        return 0
    except (OSError, ValueError, KeyError, subprocess.SubprocessError, zipfile.BadZipFile):
        print(
            json.dumps({"status": "rejected", "reason": "candidate_artifact_invalid"}),
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
