#!/usr/bin/env python3
"""Bounded preservation metadata; independent passive daemon peer, no actions."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host-scope", required=True)
    args = parser.parse_args()
    home = Path.home()
    oracle = runpy.run_path(str(Path(__file__).with_name("evaluate-observation")))
    peer = oracle["NativeRPC"](home / ".codex")
    try:
        native = {"pid": peer.pid, "startTicks": peer.start, **peer.artifact}
    finally:
        peer.sock.close()
    files = (".codex/config.toml", ".claude/settings.json",
             ".config/agent-observer/workspace.json",
             ".config/systemd/user/agent-observer.service")
    hashes = {}
    for relative in files:
        path = home / relative
        hashes[relative] = hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None
    links = {}
    for name in ("agent-observer", "agent-observer-service", "agent-observer-write",
                 "rofi-agent-plus", "rofi-agent-plus-rofi", "rofi-tmux-plus", "rofi-tmux-plus-rofi"):
        path = home / ".local/bin" / name
        links[name] = os.readlink(path) if path.is_symlink() else "file" if path.is_file() else None
    output = subprocess.run(["systemctl", "--user", "show", "agent-observer.service",
                             "--property=MainPID", "--property=ActiveState", "--property=UnitFileState",
                             "--property=InvocationID"], capture_output=True, check=True, timeout=10)
    unit = dict(line.split("=", 1) for line in output.stdout.decode().splitlines())
    cli = home / ".local/bin/agent-observer"
    result = subprocess.run([str(cli), "service", "status", "--host-scope", args.host_scope],
                            capture_output=True, check=True, timeout=30)
    if len(result.stdout) > 9 * 1024 * 1024:
        raise ValueError("bookend_service_limit")
    status = json.loads(result.stdout)
    print(json.dumps({"hostScope": args.host_scope, "providerConfigurationAndUnitHashes": hashes,
                      "selectedLinks": links, "unit": unit,
                      "serviceId": status["serviceId"], "ordinaryCodexDaemon": native}, indent=2))


if __name__ == "__main__":
    main()
