#!/usr/bin/env python3
"""Read-only installed-CLI/native comparison; no Observer imports or actions.

This is an operator evaluation tool, not another discovery implementation for
consumers. Native payloads stay in memory; stdout contains bounded metadata.
"""

import argparse
import base64
import collections
import datetime
import hashlib
import json
import os
import re
import socket
import stat
import struct
import subprocess
import time
import unicodedata
from pathlib import Path

UUID = re.compile(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\Z")
MAX_FILE = 4 * 1024 * 1024


def clock():
    return time.time_ns() // 1_000_000


def bounded_text(value, limit=256):
    if not isinstance(value, str):
        return None
    return " ".join("".join(c if c.isprintable() else " " for c in value).split())[:limit] or None


def read_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_size > MAX_FILE:
            raise ValueError("native_file_rejected")
        data = os.read(fd, MAX_FILE + 1)
        if len(data) > MAX_FILE:
            raise ValueError("native_file_limit")
        signature = lambda v: (v.st_dev, v.st_ino, v.st_size, v.st_mtime_ns, v.st_ctime_ns)
        if len(data) != info.st_size or signature(info) != signature(os.fstat(fd)) or signature(info) != signature(path.lstat()):
            raise ValueError("native_file_changed")
        def unique(pairs):
            result = {}
            for key, value in pairs:
                if key in result:
                    raise ValueError("native_duplicate_key")
                result[key] = value
            return result
        return json.loads(data, object_pairs_hook=unique)
    finally:
        os.close(fd)


def birth(pid):
    fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
    return fields[19], fields[0], int(fields[1])


def image(path, provider=None):
    with open(path, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.getuid())
                or info.st_mode & 0o022 or not 0 < info.st_size <= 512 * 1024 * 1024):
            raise ValueError("native_image_rejected")
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
        after = os.fstat(stream.fileno())
        if (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns) != (
            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns
        ):
            raise ValueError("native_image_changed")
    return {"sha256": digest, "provider": provider, "version": "unknown"}


class NativeRPC:
    """Independent stdlib Unix WebSocket client for the inspected read subset."""

    def __init__(self, home, reference_sha256=None):
        control = home / "app-server-control/app-server-control.sock"
        if not control.is_symlink() or control.lstat().st_uid != os.getuid():
            raise ValueError("native_endpoint_unavailable")
        endpoint = Path(os.readlink(control))
        expected = Path(f"/tmp/codex-daemon-{os.getuid()}") / hashlib.sha256(str(control).encode()).hexdigest()
        info = endpoint.stat()
        if endpoint != expected or not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError("native_endpoint_rejected")
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(5)
        try:
            self.sock.connect(str(endpoint))
            pid, uid, _ = struct.unpack("3i", self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if uid != os.getuid():
                raise ValueError("native_peer_rejected")
            self.pid = pid
            self.start = birth(pid)[0]
            executable = os.readlink(f"/proc/{pid}/exe").removesuffix(" (deleted)")
            match = re.fullmatch(re.escape(str(home)) + r"/packages/app-server-daemon/releases/(\d+\.\d+\.\d+)-x86_64-unknown-linux-musl/bin/codex", executable)
            if match is None or Path(f"/proc/{pid}").stat().st_uid != os.getuid():
                raise ValueError("native_provider_locator_rejected")
            self.artifact = image(f"/proc/{pid}/exe", "codex")
            if reference_sha256 is not None and reference_sha256 != self.artifact["sha256"]:
                raise ValueError("native_reference_digest_changed")
            self.artifact.update(version=match.group(1), versionEvidence="owned_release_path_and_inspected_sha256")
            self.buffer = bytearray()
            key = base64.b64encode(os.urandom(16)).decode()
            self.sock.sendall(("GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\nOrigin: http://localhost\r\n\r\n").encode())
            header = bytearray()
            while not header.endswith(b"\r\n\r\n"):
                if len(header) >= 16384:
                    raise ValueError("native_upgrade_limit")
                header.extend(self.recv(1))
            lines = header.decode().split("\r\n")
            fields = {name.lower(): value.strip() for name, value in (line.split(":", 1) for line in lines[1:] if ":" in line)}
            accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
            if " 101 " not in lines[0] or fields.get("sec-websocket-accept", "").strip() != accept:
                raise ValueError("native_upgrade_rejected")
            self.sequence = 0
            init = self.call("initialize", {"clientInfo": {"name": "observer-independent-eval", "version": "1"}})
            if init.get("codexHome") != str(home):
                raise ValueError("native_store_mismatch")
            self.send({"method": "initialized", "params": {}})
        except BaseException:
            self.sock.close()
            raise

    def recv(self, count):
        while len(self.buffer) < count:
            data = self.sock.recv(count - len(self.buffer))
            if not data:
                raise ValueError("native_peer_closed")
            self.buffer.extend(data)
        value = bytes(self.buffer[:count])
        del self.buffer[:count]
        return value

    def frame(self, payload, opcode=1):
        mask = os.urandom(4)
        size = len(payload)
        header = bytes((0x80 | opcode, 0x80 | size)) if size < 126 else bytes((0x80 | opcode, 0xfe)) + struct.pack("!H", size) if size < 65536 else bytes((0x80 | opcode, 0xff)) + struct.pack("!Q", size)
        self.sock.sendall(header + mask + bytes(v ^ mask[i % 4] for i, v in enumerate(payload)))

    def send(self, value):
        self.frame(json.dumps(value, separators=(",", ":")).encode())

    def message(self):
        result = bytearray()
        for _ in range(256):
            first, second = self.recv(2)
            opcode = first & 15
            size = second & 127
            if first & 0x70 or second & 0x80:
                raise ValueError("native_frame_rejected")
            if size == 126:
                size = struct.unpack("!H", self.recv(2))[0]
            elif size == 127:
                size = struct.unpack("!Q", self.recv(8))[0]
            if size + len(result) > 8 * 1024 * 1024:
                raise ValueError("native_message_limit")
            body = self.recv(size)
            if opcode == 8:
                raise ValueError("native_peer_closed")
            if opcode == 9:
                self.frame(body, 10)
                continue
            if opcode == 10:
                continue
            if opcode not in (0, 1):
                raise ValueError("native_opcode_rejected")
            result.extend(body)
            if first & 0x80:
                return json.loads(result)
        raise ValueError("native_frame_limit")

    def call(self, method, params):
        if method not in {"initialize", "thread/list", "thread/loaded/list", "thread/read", "thread/turns/list"}:
            raise ValueError("non_read_method_rejected")
        if method == "thread/read" and params.get("includeTurns") is not False:
            raise ValueError("content_read_rejected")
        if method == "thread/turns/list" and params != {"threadId": params.get("threadId"), "limit": 1, "sortDirection": "desc", "itemsView": "notLoaded"}:
            raise ValueError("content_read_rejected")
        self.sequence += 1
        self.send({"id": self.sequence, "method": method, "params": params})
        deadline = time.monotonic() + 8
        for _ in range(256):
            if time.monotonic() > deadline:
                raise ValueError("native_rpc_timeout")
            value = self.message()
            if value.get("id") != self.sequence or "method" in value:
                continue
            if "error" in value:
                raise ValueError("native_rpc_error")
            return value["result"]
        raise ValueError("native_notification_limit")

    def pages(self, method):
        rows, cursors, cursor = [], set(), None
        for _ in range(32):
            params = {"cursor": cursor}
            if method == "thread/list":
                params["limit"] = 100
                # Deliberately independent of Observer's transport/constants.
                params["sourceKinds"] = ["cli", "vscode", "exec", "appServer", "subAgent", "subAgentReview", "subAgentCompact", "subAgentThreadSpawn", "subAgentOther", "unknown"]
                params["useStateDbOnly"] = True
            response = self.call(method, params)
            rows.extend(response["data"])
            if len(rows) > 2048:
                raise ValueError("native_inventory_limit")
            cursor = response.get("nextCursor")
            if cursor is None:
                return rows
            if cursor in cursors:
                raise ValueError("native_cursor_cycle")
            cursors.add(cursor)
        raise ValueError("native_page_limit")

    def close(self):
        self.sock.close()


def _native_child_source(source):
    """Independent bounded source marker check; no Observer implementation import."""
    sub = source.get("subAgent") if isinstance(source, dict) and set(source) == {"subAgent"} else None
    if isinstance(sub, str) and sub in {"review", "compact", "memory_consolidation"}:
        return True
    if isinstance(sub, dict) and set(sub) == {"other"}:
        return (isinstance(sub["other"], str) and 0 < len(sub["other"]) <= 128
                and not any(unicodedata.category(c).startswith("C") for c in sub["other"]))
    if isinstance(sub, dict) and set(sub) == {"thread_spawn"}:
        spawn = sub["thread_spawn"]
        return (isinstance(spawn, dict) and isinstance(spawn.get("parent_thread_id"), str)
                and UUID.fullmatch(spawn["parent_thread_id"]) is not None)
    return False


def _native_detail_matches_catalog(sid, catalog, detail):
    """Keep exact thread checks; detail can resolve a live child's self-root list."""
    if detail.get("id") != sid:
        return False
    root = detail.get("sessionId")
    if not isinstance(root, str) or UUID.fullmatch(root) is None:
        return False
    if catalog is None or root == catalog.get("sessionId"):
        return True
    status = detail.get("status")
    return (
        catalog.get("id") == sid and catalog.get("sessionId") == sid
        and _native_child_source(catalog.get("source"))
        and _native_child_source(detail.get("source"))
        and catalog.get("threadSource") != "user" and detail.get("threadSource") != "user"
        and isinstance(status, dict) and status.get("type") in {"idle", "active", "systemError"}
    )


def codex_reference(client):
    loaded = set(client.pages("thread/loaded/list"))
    saved = client.pages("thread/list")
    records = {r["id"]: r for r in saved}
    classification_gaps = []
    readable = set()
    for sid in loaded:
        detail = client.call("thread/read", {"threadId": sid, "includeTurns": False})["thread"]
        if not _native_detail_matches_catalog(sid, records.get(sid), detail):
            raise ValueError("native_detail_identity_conflict")
        records[sid] = detail
        readable.add(sid)
    saved_reads = 0
    unreadable_saved = set()
    for sid, record in records.items():
        if sid in loaded:
            continue
        if saved_reads >= 1000:
            classification_gaps.append("native_saved_classification_limit")
            break
        saved_reads += 1
        try:
            detail = client.call("thread/read", {"threadId": sid, "includeTurns": False})["thread"]
        except (ValueError, OSError, KeyError):
            classification_gaps.append("native_saved_detail_unavailable:" + sid)
            unreadable_saved.add(sid)
            continue
        if not _native_detail_matches_catalog(sid, record, detail):
            raise ValueError("native_detail_identity_conflict")
        records[sid] = detail
        readable.add(sid)
    rows = {}
    saved_ids = {r["id"] for r in saved}
    for sid, r in records.items():
        if not UUID.fullmatch(sid):
            raise ValueError("native_id_invalid")
        saved_identity = sid in saved_ids and sid in readable
        source = r.get("source")
        native_child = _native_child_source(source)
        classification = r.get("threadSource")
        regular = source is None or isinstance(source, str) and source in {"cli", "vscode", "exec", "appServer", "unknown"}
        kind = "child" if classification == "subagent" or native_child and classification != "user" else "system" if classification in {"system", "thread_title"} and regular else "user" if classification == "user" and regular else "unknown"
        status = r.get("status", {}).get("type")
        if status == "notLoaded" and not saved_identity:
            status = None
        flags = r.get("status", {}).get("activeFlags", [])
        valid_waits = isinstance(flags, list) and all(isinstance(f, str) for f in flags) and len(flags) == len(set(flags)) and all(f in ("waitingOnApproval", "waitingOnUserInput") for f in flags)
        phase = "waiting" if status == "idle" else "blocked" if status == "active" and (
            valid_waits and flags
        ) else "working" if status == "active" and flags == [] else None if status == "notLoaded" else "unknown"
        runtime = "parked" if status == "notLoaded" else "running" if status in ("idle", "active", "systemError") else "unknown"
        blocked_reasons = sorted({"approval" if f == "waitingOnApproval" else "question" for f in flags}) if phase == "blocked" else []
        at, reason, outcome, outcome_at, latest_turn = None, None, None, None, None
        try:
            turns = client.call("thread/turns/list", {"threadId": sid, "limit": 1, "sortDirection": "desc", "itemsView": "notLoaded"})["data"]
            if turns:
                turn = turns[0]
                if turn.get("items") != [] or turn.get("itemsView") != "notLoaded":
                    raise ValueError("native_items_not_excluded")
                stamp = turn.get("completedAt") if turn.get("completedAt") is not None else turn.get("startedAt")
                at = stamp * 1000 if type(stamp) is int else None
                if type(turn.get("completedAt")) is int:
                    outcome = {"completed": "completed", "failed": "failed", "interrupted": "cancelled"}.get(turn.get("status"))
                    outcome_at = turn["completedAt"] * 1000 if outcome else None
                elif turn.get("status") == "inProgress":
                    outcome = "unknown"
                if saved_identity:
                    latest_turn = {"id": turn.get("id"),
                                   "status": {"inProgress": "in_progress", "completed": "completed", "failed": "failed", "interrupted": "cancelled"}.get(turn.get("status"), "unknown"),
                                   "startedAt": turn["startedAt"] * 1000 if type(turn.get("startedAt")) is int else None,
                                   "completedAt": turn["completedAt"] * 1000 if type(turn.get("completedAt")) is int else None,
                                   "durationMs": turn.get("durationMs"),
                                   "timestampPrecisionMs": 1000 if type(turn.get("startedAt")) is int or type(turn.get("completedAt")) is int else None}
            reason = "no_native_turn_clock" if at is None else "native_turn_metadata"
        except (ValueError, OSError, KeyError):
            reason = "native_turn_read_unavailable"
        rows[sid] = {"title": bounded_text(r.get("name")), "cwd": bounded_text(r.get("cwd"), 4096), "sessionTreeRootId": r.get("sessionId"), "createdAt": r.get("createdAt") * 1000 if type(r.get("createdAt")) is int else None, "hasSavedHistory": saved_identity, "runtime": runtime, "phase": phase, "blockedReasons": blocked_reasons, "kind": kind, "activity": at, "activityReason": reason, "status": status, "activeFlags": flags, "outcome": outcome, "outcomeAt": outcome_at}
        rows[sid].update(lastUpdated=r["updatedAt"] * 1000 if saved_identity and type(r.get("updatedAt")) is int else None,
                         latestTurn=latest_turn)
    if birth(client.pid)[0] != client.start:
        raise ValueError("native_runtime_changed")
    loaded_after = set(client.pages("thread/loaded/list"))
    if loaded_after != loaded:
        classification_gaps.append("native_loaded_inventory_changed_during_sample")
    return {"sampleAt": clock(), "rows": rows, "loaded": sorted(loaded), "loadedAfter": sorted(loaded_after), "saved": sorted(r["id"] for r in saved), "runtimeGaps": classification_gaps, "runtime": {"pid": client.pid, "startTicks": client.start, **client.artifact}}


def cli_call(cli, argv, snapshot=None):
    process = subprocess.run([str(cli), *argv], input=snapshot, capture_output=True, cwd="/tmp", timeout=40)
    if process.returncode:
        raise ValueError("installed_cli_failed")
    if len(process.stdout) > 8 * 1024 * 1024 + 16384:
        raise ValueError("installed_cli_output_limit")
    return process.stdout


def identity_scope(snapshot, host, providers, codex_home=None):
    sources = {source["provider"]: source for source in snapshot["sources"]}
    expected = {}
    checks = [len(sources) == len(snapshot["sources"])]
    # Cached snapshots retain every configured provider. Native comparisons may
    # intentionally inspect one provider, but every frame identity still needs
    # independent store/host validation, including healthy siblings.
    for provider in sorted(set(providers) | set(sources)):
        if provider not in {"codex", "claude"}:
            checks.append(False)
            continue
        home = str(
            (Path.home() / ".codex" if codex_home is None else codex_home)
            if provider == "codex"
            else Path.home() / ".claude"
        )
        selector = "explicit"
        namespace = "sha256:" + hashlib.sha256(json.dumps([provider, home, selector, os.getuid()], separators=(",", ":")).encode()).hexdigest()
        expected[provider] = namespace
        source = sources.get(provider, {})
        checks.append(source.get("configHome") == home and source.get("configHomeKind") == selector and source.get("namespace") == namespace)
    host_ok = snapshot["host"]["authority"] == host and snapshot["host"]["nativeHostname"] == socket.gethostname() and snapshot["host"]["uid"] == os.getuid()
    refs = []
    rows_ok = True
    for row in snapshot["sessions"]:
        reference = row["identity"]
        provider = reference["provider"]
        refs.append(tuple(sorted(reference.items())))
        rows_ok &= provider in sources and provider in expected and reference["hostScope"] == host and reference["namespace"] == expected.get(provider) and reference["nativeIdKind"] == ("thread" if provider == "codex" else "session") and bool(UUID.fullmatch(reference["nativeId"]))
    return {"hostProvenance": host_ok, "storeScopes": all(checks), "fullRowReferences": rows_ok and len(refs) == len(set(refs)), "rowsChecked": len(refs), "providersChecked": sorted(expected), "nativeReferenceProviders": sorted(set(providers))}


def compare(before, snapshot, after, provider):
    actual = {r["identity"]["nativeId"]: r for r in snapshot["sessions"] if r["identity"]["provider"] == provider}
    pre, post = before["rows"], after["rows"]
    stable_ids = set(pre) & set(post)
    checks, issues, rows = collections.Counter(), [], []
    for sid in sorted(set(pre) | set(post) | set(actual)):
        a, b, c = pre.get(sid), post.get(sid), actual.get(sid)
        if a is None and b is None:
            continue
        if sid not in stable_ids:
            issues.append({"id": sid, "field": "membership", "result": "sampling_race"})
            continue
        if c is None:
            issues.append({"id": sid, "field": "membership", "result": "missing_cli_row"})
            continue
        checks["membership"] += 1
        comparisons = {"title": c["title"], "cwd": c["cwd"], "runtime": c["runtime"]["value"], "phase": c["phase"]["value"] if c["phase"] else None, "activity": c["activity"]["at"], "kind": c["kind"]}
        if provider == "codex":
            comparisons.update(sessionTreeRootId=c["nativeIds"]["sessionTreeRootId"], blockedReasons=c["blockedReasons"], createdAt=c["createdAt"], hasSavedHistory=c["hasSavedHistory"],
                               outcome=c["outcome"]["value"], outcomeAt=c["outcome"]["observedAt"])
            comparisons.update(lastUpdated=c["lastUpdated"]["at"], latestTurn=c["latestTurn"]["value"])
            if not b["hasSavedHistory"] and (c["lastUpdated"]["at"] is not None or c["latestTurn"]["value"] is not None):
                issues.append({"id": sid, "field": "timingAdmission", "result": "unproved_clock_promoted"})
        for field, observed in comparisons.items():
            expected = b.get(field)
            if a.get(field) != expected:
                issues.append({"id": sid, "field": field, "result": "sampling_race"})
            elif expected is None or field == "kind" and expected == "unknown":
                if field == "phase" and b.get("runtime") == "parked":
                    if observed is not None:
                        issues.append({"id": sid, "field": field, "result": "mismatch", "native": None, "cli": observed})
                    else:
                        checks[field] += 1
                    continue
                checks[field + "_unproved"] += 1
                if field == "phase" and (b.get("runtime") == "running" or observed != "unknown") or field == "activity" and (b.get("runtime") == "running" and b.get("hasSavedHistory", True) or observed is not None):
                    issues.append({"id": sid, "field": field, "result": "native_reference_unproved", "cli": observed})
            elif expected != observed:
                issues.append({"id": sid, "field": field, "result": "mismatch", "native": expected, "cli": observed})
            else:
                checks[field] += 1
        if c["runtime"]["value"] == "running":
            rows.append({"id": sid, "title": c["title"], "cwd": c["cwd"], "cliPhase": c["phase"]["value"], "cliKind": c["kind"], "nativeKind": b.get("kind"), "nativePhase": b.get("phase"), "nativeStatus": b.get("nativeStatus", b.get("status")), "nativeJobState": b.get("nativeJobState"), "nativeTempo": b.get("nativeTempo"), "workerVersion": b.get("workerVersion"), "activityAt": c["activity"]["at"]})
    # A stable public-only row is unresolved, not automatically a false positive:
    # the independently bounded history scan may not establish its membership.
    for sid in sorted(set(actual) - set(pre) - set(post)):
        issues.append({"id": sid, "field": "membership", "result": "cli_only_unproved", "runtime": actual[sid]["runtime"]["value"]})
    native_active = [{"id": sid, "title": b.get("title"), "cwd": b.get("cwd"), "nativeKind": b.get("kind"), "nativePhaseCandidate": b.get("phase"), "nativeStatus": b.get("nativeStatus", b.get("status")), "activityAt": b.get("activity")} for sid, b in sorted(post.items()) if b.get("runtime") == "running"]
    context_differences = [{"id": sid, "recordedCwd": actual[sid]["cwd"], "latestConversationCwd": b["latestConversationCwd"]} for sid, b in sorted(post.items()) if sid in actual and b.get("latestConversationCwd") and b["latestConversationCwd"] != actual[sid]["cwd"]]
    return {"nativeBeforeRows": len(pre), "nativeAfterRows": len(post), "cliRows": len(actual), "nativeCounts": {"running": len(native_active), "activityKnown": sum(r.get("activity") is not None for r in post.values()), "classification": dict(collections.Counter(r.get("kind", "unknown") for r in post.values()))}, "checks": dict(checks), "nativeActive": native_active, "active": rows, "contextDifferences": context_differences, "issues": issues}


def read_client_checks(cli, payload):
    snapshot = json.loads(payload)
    listed = json.loads(cli_call(cli, ["list", "--input", "-", "--json"], payload))
    with_children = json.loads(cli_call(cli, ["list", "--input", "-", "--include-children", "--json"], payload))
    with_system = json.loads(cli_call(cli, ["list", "--input", "-", "--include-children", "--include-system", "--json"], payload))
    expected = [r for r in snapshot["sessions"] if r["kind"] not in {"child", "system"}]
    def identity(row):
        return json.dumps(row["identity"], sort_keys=True)
    attention = {"blocked": 0, "waiting": 1, "working": 2, "unknown": 3}
    def order(row):
        at = row["activity"]["at"] if row["activity"]["health"] == "current" else row["activity"].get("lastKnownAt")
        r = row["identity"]
        return (attention[row["phase"]["value"] if row["phase"] else "unknown"], at is None, -(at or 0), r["hostScope"], r["provider"], r["namespace"], r["nativeIdKind"], r["nativeId"])
    display_before = clock()
    human = cli_call(cli, ["list", "--input", "-"], payload).decode().splitlines()
    display_after = clock()
    age_ok = True
    for line, row in zip(human[1:], listed["sessions"], strict=True):
        at = row["activity"]["at"] if row["activity"]["health"] == "current" else row["activity"].get("lastKnownAt")
        def age_at(seconds, at=at, row=row):
            age = "unknown" if seconds is None else "clock-ahead" if seconds < 0 else next(str(seconds // unit) + label for unit, label in ((86400, "d"), (3600, "h"), (60, "m"), (1, "s")) if seconds >= unit or unit == 1)
            return "stale:" + age if at is not None and row["activity"]["health"] == "stale" else age
        expected_ages = {"unknown"} if at is None else {
            age_at(seconds) for seconds in range((display_before - at) // 1000, (display_after - at) // 1000 + 1)
        }
        age_ok &= line.split("  ")[4] in expected_ages
    shown = 0
    for row in listed["sessions"]:
        if row["runtime"]["value"] != "running":
            continue
        result = json.loads(cli_call(cli, ["show", "--input", "-", "--ref", json.dumps(row["identity"]), "--json"], payload))
        if result != row:
            raise ValueError("installed_show_mismatch")
        shown += 1
    doctor = json.loads(cli_call(cli, ["doctor", "--input", "-", "--json"], payload))
    return {"defaultChildFiltering": {identity(r) for r in listed["sessions"]} == {identity(r) for r in expected}, "includeChildrenInventory": {identity(r) for r in with_children["sessions"]} == {identity(r) for r in snapshot["sessions"] if r["kind"] != "system"}, "includeSystemInventory": {identity(r) for r in with_system["sessions"]} == {identity(r) for r in snapshot["sessions"]}, "attentionActivityOrdering": listed["sessions"] == sorted(expected, key=order), "humanAgeRendering": age_ok and len(human) == len(listed["sessions"]) + 1, "exactReferenceShowRows": shown, "doctorSessionCount": doctor["sessionCount"] == len(snapshot["sessions"]), "cliRows": len(listed["sessions"]), "filteredChildren": len(snapshot["sessions"]) - len(listed["sessions"])}


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host-scope", required=True)
    parser.add_argument("--cli", type=Path, default=Path.home() / ".local/bin/agent-observer")
    parser.add_argument("--provider", choices=("codex",), action="append", required=True)
    parser.add_argument(
        "--codex-home",
        type=Path,
        default=Path.home() / ".codex",
        help="Codex store selected for the native reference and expected in Observer data",
    )
    parser.add_argument("--rounds", type=int, choices=range(1, 5), default=2)
    parser.add_argument("--service-socket", type=Path, help="compare explicit cached service output; no autostart")
    parser.add_argument("--codex-reference-sha256", help="optional operator guard for the inspected daemon hash; compatibility is contract based")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    samples = []
    if args.codex_reference_sha256 is not None and re.fullmatch("[0-9a-f]{64}", args.codex_reference_sha256) is None:
        raise ValueError("reference_digest_invalid")
    client = NativeRPC(args.codex_home, args.codex_reference_sha256) if "codex" in args.provider else None
    def native():
        result = {}
        if client is not None:
            result["codex"] = codex_reference(client)
        return result
    try:
        for _ in range(args.rounds):
            before = native()
            argv = ["service", "snapshot", "--socket", str(args.service_socket), "--host-scope", args.host_scope] if args.service_socket else ["snapshot", "--host-scope", args.host_scope]
            if args.service_socket is None:
                for provider in args.provider:
                    argv += ["--provider", provider]
                argv += ["--codex-home", str(args.codex_home)]
            payload = cli_call(args.cli, argv)
            snapshot = json.loads(payload)
            service = None
            if args.service_socket:
                if snapshot.get("serviceProtocol") != 4 or snapshot.get("hostScope") != args.host_scope or snapshot.get("uid") != os.geteuid() or snapshot.get("snapshot") is None:
                    raise ValueError("service_scope_unavailable")
                service = {k: snapshot[k] for k in ("serviceProtocol", "serviceId", "bootId", "hostScope", "viewRevision", "emittedAt", "emittedBoottimeMs", "clockDomain", "sources")}
                snapshot = snapshot["snapshot"]
                payload = json.dumps(snapshot, separators=(",", ":")).encode()
            after = native()
            samples.append({**({"service": service} if service else {}), "nativeBeforeAt": {p: v["sampleAt"] for p, v in before.items()}, "cliCollectedAt": snapshot["collectedAt"], "nativeAfterAt": {p: v["sampleAt"] for p, v in after.items()}, "sourceHealth": snapshot["sourceHealth"], "errors": snapshot["errors"], "sources": [{k: source[k] for k in ("provider", "sourceHealth", "coverage", "limitations", "errors")} for source in snapshot["sources"]], "identityScope": identity_scope(snapshot, args.host_scope, args.provider, codex_home=args.codex_home), "providers": {p: compare(before[p], snapshot, after[p], p) for p in args.provider}, "readClient": read_client_checks(args.cli, payload), "nativeRuntime": after.get("codex", {}).get("runtime"), "nativeReferenceLimits": {p: {k: v[k] for k in ("historyGaps", "historyBytesScanned", "runtimeGaps") if k in v} for p, v in after.items()}})
    finally:
        if client is not None:
            client.close()
    print(json.dumps({"evaluationVersion": 1, "hostScope": args.host_scope, "cliVersion": cli_call(args.cli, ["--version"]).decode().strip(), "selectedCli": str(args.cli.resolve()), "referenceImportsObserver": False, "ordinaryProviderActions": False, "controlledNativeCasesRun": False, "samples": samples}, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as exc:
        # Never print native error payloads or command output.
        code = str(exc) if isinstance(exc, ValueError) and re.fullmatch("[a-z_]{1,96}", str(exc)) else "evaluation_unavailable"
        print(json.dumps({"error": code, "exceptionClass": type(exc).__name__}))
        raise SystemExit(2) from None
