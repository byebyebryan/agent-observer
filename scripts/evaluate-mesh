#!/usr/bin/env python3
"""Compare an installed local Mesh read with the independent native oracle.

No Observer imports, collection or provider actions. The temporary read wrapper
only reconstructs the Mesh owner into the existing evaluation harness's input.
Native evidence comes independently from evaluate-observation, never Mesh.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host-scope", required=True)
    parser.add_argument("--cli", type=Path, required=True)
    parser.add_argument("--socket", type=Path, required=True)
    parser.add_argument("--provider", choices=("codex", "claude"), action="append", required=True)
    parser.add_argument("--rounds", type=int, choices=range(1, 5), default=2)
    args = parser.parse_args()
    assert args.cli.is_absolute() and args.socket.is_absolute()
    script = Path(__file__).resolve().with_name("evaluate-observation")
    with tempfile.TemporaryDirectory(prefix="observer-mesh-native-") as directory:
        wrapper = Path(directory) / "read"
        mesh_argv = [str(args.cli), "mesh", "snapshot", "--scope", "local", "--local-host",
                     args.host_scope, "--socket", str(args.socket)]
        wrapper.write_text("#!" + sys.executable + "\n" + f"""
import json,subprocess,sys
if sys.argv[1:3] == ['service','snapshot']:
 result=subprocess.run({mesh_argv!r},capture_output=True,check=True,timeout=30)
 frame=json.loads(result.stdout)
 assert frame['protocol']=='agent-observer.mesh-candidate.v1'
 assert frame['mesh']['scope']['hostIds']==[{args.host_scope!r}]
 host=frame['mesh']['hosts'][0]
 assert host['delivery']['status']=='ready' and host['owner'] is not None
 owner=host['owner']
 snapshot={{**owner['metadata'],'sessions':frame['sessions']}}
 print(json.dumps({{**owner['service'],'snapshot':snapshot}}))
else:
 raise SystemExit(subprocess.run([{str(args.cli)!r},*sys.argv[1:]]).returncode)
""")
        wrapper.chmod(0o700)
        argv = [sys.executable, str(script), "--host-scope", args.host_scope, "--cli", str(wrapper),
                "--service-socket", str(args.socket), "--rounds", str(args.rounds)]
        for provider in args.provider:
            argv.extend(["--provider", provider])
        result = subprocess.run(argv, capture_output=True, check=True, timeout=300, env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
        receipt = json.loads(result.stdout)
        receipt["meshRead"] = {"cli": str(args.cli), "profile": "agent-observer.mesh-candidate.v1",
                               "access": "cached", "scope": "local", "wrapperImportsObserver": False}
        receipt["selectedCli"] = str(args.cli)
        print(json.dumps(receipt, indent=2))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print(json.dumps({"error": "mesh_native_evaluation_failed"}), file=sys.stderr)
        raise SystemExit(1) from None
