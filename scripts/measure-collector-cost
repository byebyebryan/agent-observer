#!/usr/bin/env python3
"""Measure one explicit systemd collector without adding readers or provider work.

Reuse the bounded UID/incarnation-checked process tree sampler. Separate root
CPU from helpers (reaped child ticks plus live descendants); retain counters
only. A transient candidate unit can be measured before managed selection.
"""

import argparse
import json
import os
import runpy
import time
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", choices=("snap", "starship"), required=True)
    parser.add_argument("--unit", default="agent-observer.service")
    parser.add_argument("--duration", type=int, default=600)
    parser.add_argument("--warmup", type=int, default=30)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 30 <= args.duration <= 1800 or not 0 <= args.warmup <= 60:
        parser.error("duration 30..1800 and warmup 0..60 required")
    sampler = runpy.run_path(str(Path(__file__).with_name("measure-read-delivery")))
    pid, birth = sampler["unit_root"](args.unit)
    node = Path(f"/proc/{pid}")
    command = (node / "cmdline").read_bytes().split(b"\0")
    # Collector argv contains configuration paths/cadence, never native payloads.
    if len(command) < 2 or not command[1].endswith(b"/agent-observer-service"):
        raise ValueError("collector_entrypoint_unproved")
    image = str((node / "exe").resolve(strict=True))
    time.sleep(args.warmup)

    def sample():
        tree = sampler["tree"](pid, birth)
        fields = (node / "stat").read_text().rsplit(")", 1)[1].split()
        if int(fields[19]) != birth:
            raise ValueError("measurement_incarnation")
        # Read the root again after the tree; keep time ordering consistent.
        own = sum(int(fields[i]) for i in (11, 12))
        tree["rootTicks"] = own
        return tree

    begin = time.monotonic()
    first = sample()
    rows = [{"seconds": 0, **first}]
    print(json.dumps({"host": args.host, "unit": args.unit, "state": "started"}), flush=True)
    while time.monotonic() - begin < args.duration:
        time.sleep(min(1, max(0, args.duration - (time.monotonic() - begin))))
        rows.append({"seconds": round(time.monotonic() - begin, 3), **sample()})
    elapsed = time.monotonic() - begin
    last = rows[-1]
    cpu = (last["ticks"] - first["ticks"]) / os.sysconf("SC_CLK_TCK")
    root = (last["rootTicks"] - first["rootTicks"]) / os.sysconf("SC_CLK_TCK")
    result = {"status": "measured", "host": args.host, "unit": args.unit,
              "rootPid": pid, "rootStartTicks": birth, "interpreter": image,
              "entrypoint": command[1].decode(), "warmupSeconds": args.warmup,
              "durationSeconds": round(elapsed, 3), "addedReaders": 0,
              "percentOneCore": {"root": round(root / elapsed * 100, 3),
                                 "helpers": round((cpu - root) / elapsed * 100, 3),
                                 "total": round(cpu / elapsed * 100, 3)},
              "cpuSeconds": {"root": round(root, 3), "total": round(cpu, 3)},
              "resources": {key: {"mean": round(sum(r[key] for r in rows) / len(rows)),
                                  "peak": max(r[key] for r in rows), "end": last[key]}
                            for key in ("rssBytes", "pssBytes", "fds", "processes")},
              "pssComplete": all(r["pssComplete"] for r in rows),
              "samples": rows, "rawPayloadsRetained": False,
              "limits": ["ordinary active host", "one-second process-tree sampling",
                         "remote SSH/bridge excluded", "concurrent workloads"]}
    args.output.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({"host": args.host, "state": "complete", "percentOneCore": result["percentOneCore"]}), flush=True)


if __name__ == "__main__":
    main()
