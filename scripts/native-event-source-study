#!/usr/bin/env python3
"""Isolated source-coverage study; no production event implementation.

Driver uses existing owned PTY helpers. Native RPC/callback facts are independent
of Observer; installed snapshots are a separate identity/state comparison.
"""

import argparse
import collections
import json
import os
import pty
import runpy
import select
import shlex
import time
import uuid
from pathlib import Path


def records(root):
    path = root / "event-source-records.jsonl"
    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []


def codex(root):
    Base = runpy.run_path(str(root / "native-acceptance"))["Proof"]
    RPC = runpy.run_path(str(root / "evaluate-observation"))["NativeRPC"]
    proof = Base("codex")
    fixture = json.loads((root / "fixture.json").read_text())
    config = proof.base / "codex/config.toml"
    sink = [fixture["prefix"] + "/bin/python", "-I", "-B", str(root / "capture-event-source-study"), "codex_notify"]
    config.write_text("notify = " + json.dumps(sink) + "\n" + config.read_text() + "\n[tui]\nnotifications = false\n")
    peer = None
    counts, notices, targets = collections.Counter(), [], []

    def drain():
        for _ in range(256):
            if not peer.buffer and not select.select([peer.sock], [], [], 0)[0]:
                break
            value = peer.message()
            method = value.get("method")
            if not isinstance(method, str) or len(method) > 128:
                continue
            counts[method] += 1
            if method in {"thread/started", "thread/status/changed", "thread/closed", "turn/started", "turn/completed"}:
                params = value.get("params") or {}
                sid = params.get("threadId") or (params.get("thread") or {}).get("id")
                if isinstance(sid, str) and len(sid) <= 256:
                    notices.append({"method": method, "nativeId": sid})

    try:
        bootstrap = proof.spawn(proof.handoff())
        proof.pause(bootstrap, 5)
        proof.assert_native_client(bootstrap)
        peer = RPC(proof.base / "codex")
        baseline = set(peer.pages("thread/loaded/list"))
        assert baseline == set(peer.pages("thread/loaded/list"))
        for _ in range(2):
            before = set(peer.pages("thread/loaded/list"))
            viewer = proof.spawn(proof.handoff())
            proof.pause(viewer, 5)
            proof.assert_native_client(viewer)
            drain()
            added = set(peer.pages("thread/loaded/list")) - before
            native = [peer.call("thread/read", {"threadId": sid, "includeTurns": False})["thread"] for sid in added]
            users = [row for row in native if row.get("threadSource") == "user"]
            assert len(users) == 1, "exact_private_native_identity_unproved"
            ref = next(row["identity"] for row in proof.snapshot()["sessions"] if row["identity"]["nativeId"] == users[0]["id"])
            targets.append((users[0]["id"], ref, viewer))
        for _sid, _ref, viewer in targets:
            os.write(viewer[1], b"\x1b[200~Reply only with OK.\x1b[201~\r")
            proof.pause(viewer, .5)
            os.write(viewer[1], b"\r")
        deadline = time.monotonic() + 75
        while time.monotonic() < deadline:
            for _sid, _ref, viewer in targets:
                proof.pause(viewer, .1)
            drain()
            observed = records(root)
            if all(any(r["source"] == "codex_notify" and r["nativeId"] == sid for r in observed) for sid, _ref, _viewer in targets):
                break
        else:
            raise RuntimeError("private_completion_callback_unproved")
        proof.pause(bootstrap, 2)
        drain()
        comparisons = []
        for sid, ref, _viewer in targets:
            callback = next(r for r in records(root) if r["source"] == "codex_notify" and r["nativeId"] == sid)
            latest = peer.call("thread/turns/list", {"threadId": sid, "limit": 1, "sortDirection": "desc", "itemsView": "notLoaded"})["data"][0]
            row = proof.row(ref)
            assert callback["nativeTurnId"] == latest["id"]
            assert row["runtime"]["value"] == "running" and row["phase"]["value"] == "waiting"
            own = [n for n in notices if n["nativeId"] == sid]
            comparisons.append({"nativeId": sid, "nativeTurnId": latest["id"], "nativeOutcome": latest.get("status"),
                "callbackMatchesIndependentThreadAndTurn": True, "installedRowMatches": True,
                "passiveMethodsForThread": dict(collections.Counter(n["method"] for n in own)),
                "passiveTurnCompletedReceived": any(n["method"] == "turn/completed" for n in own)})
        result = {"hostScope": proof.host, "provider": "codex", "status": "completed_source_study",
            "fixture": fixture, "passiveListenerResumedLoadedOrSubscribed": False,
            "nativeOracleImportsObserver": False, "listenerMethods": dict(counts), "targets": comparisons,
            "ordinaryProviderActions": False, "terminalOutputPersisted": False,
            "graphicalDeliveryProved": False, "productionEventPublisherProved": False}
        (root / "event-source-codex.json").write_text(json.dumps(result, indent=2) + "\n")
        print(json.dumps(result))
    finally:
        if peer:
            peer.close()
        for client in list(proof.clients):
            proof.stop(client)


def claude(root):
    Native = runpy.run_path(str(root / "native-claude-interactive-proof"))["NativeProof"]
    proof = Native()
    fixture = json.loads((root / "fixture.json").read_text())
    python = fixture["prefix"] + "/bin/python"
    capture = {"type": "command", "command": shlex.join([python, "-I", "-B", str(root / "capture-event-source-study"), "claude_hook"]), "timeout": 2}
    continuation = root / "study-continue-once.py"
    continuation.write_text('import json,os,sys\nfrom pathlib import Path\np=json.load(sys.stdin)\nm=Path(os.environ["NATIVE_PROOF_ROOT"])/"study-continued-once"\nif not m.exists() and not p.get("stop_hook_active"):\n m.touch(mode=0o600); print(json.dumps({"decision":"block","reason":"Continue once and reply only with DONE."}))\nelse: print("{}")\n')
    continue_hook = {"type": "command", "command": shlex.join([python, "-I", "-B", str(continuation)]), "timeout": 2}
    config = {"disableAgentView": True, "disableAllHooks": False, "enabledPlugins": {},
        "permissions": {"ask": ["Bash", "Write"]},
        "hooks": {event: [{"hooks": [capture] + ([continue_hook] if event == "Stop" else [])}]
            for event in ("Stop", "SubagentStop", "UserPromptSubmit", "Notification", "PermissionRequest")}}
    (proof.home / "settings.json").write_text(json.dumps(config) + "\n")
    for path in (proof.base / "home/.claude.json", proof.home / ".claude.json"):
        value = json.loads(path.read_text())
        value["preferredNotifChannel"] = "notifications_disabled"
        path.write_text(json.dumps(value) + "\n")
    sid = str(uuid.uuid4())
    client = None
    try:
        client = proof.spawn(sid, prompt="Reply only with OK.", name="Event source study")
        proof.until(lambda: len([r for r in records(root) if r["nativeId"] == sid and r["nativeEvent"] == "Stop"]) >= 2, "parallel_stop_continuation_unproved", 100)
        proof.phase(client, "idle")
        stop = [r for r in records(root) if r["nativeId"] == sid and r["nativeEvent"] == "Stop"]
        assert (root / "study-continued-once").exists()
        assert any(r["stopHookActive"] is False for r in stop) and any(r["stopHookActive"] is True for r in stop)
        before = len(records(root))
        target = proof.base / "workspace/event-study-approval.txt"
        proof.send(client, "Use Bash to write OK to event-study-approval.txt.")
        proof.phase(client, "waiting", "permission prompt")
        proof.until(lambda: any(r["nativeId"] == sid and r["notificationType"] == "permission_prompt" for r in records(root)[before:]), "native_attention_notice_unproved", 30)
        assert not target.exists()
        subset = [r for r in records(root) if r["nativeId"] == sid]
        permission = [r for r in subset if r["nativeEvent"] == "PermissionRequest"]
        notice = [r for r in subset if r["notificationType"] == "permission_prompt"]
        installed = __import__("subprocess").run(["agent-observer", "snapshot", "--host-scope", "snap", "--provider", "claude"], capture_output=True, timeout=20)
        assert installed.returncode == 0
        row = next(r for r in json.loads(installed.stdout)["sessions"] if r["identity"]["nativeId"] == sid)
        assert row["runtime"]["value"] == "running" and row["phase"]["value"] == "blocked"
        result = {"hostScope": "snap", "provider": "claude", "status": "completed_source_study", "fixture": fixture,
            "nativeId": sid, "agentViewDisabled": True, "nativeAlertsDisabled": True,
            "stopCount": len(stop), "stopPromptIds": [r["nativePromptId"] for r in stop],
            "samePromptAcrossContinuation": len({r["nativePromptId"] for r in stop}) == 1,
            "parallelContinuationObserved": True, "permissionRequestCount": len(permission),
            "permissionNoticeCount": len(notice), "permissionNoticeAfterRequestMs": notice[0]["receivedBoottimeMs"] - permission[0]["receivedBoottimeMs"] if permission else None,
            "heldApprovalNotExecuted": True, "installedRowMatchesNativeBlocked": True,
            "sourceEvents": dict(collections.Counter(r["nativeEvent"] for r in subset)),
            "ordinaryProviderActions": False, "terminalOutputPersisted": False,
            "productionEventPublisherProved": False, "graphicalDeliveryProved": False}
        (root / "event-source-claude.json").write_text(json.dumps(result, indent=2) + "\n")
        print(json.dumps(result))
    finally:
        if client:
            proof.stop(client)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("codex", "claude"), required=True)
    args = parser.parse_args()
    root = Path(os.environ["NATIVE_PROOF_ROOT"])
    assert os.getuid() == 0 and root.resolve() == root and root.stat().st_uid == 0
    assert all(json.loads((root / "ready.json").read_text()).values())
    {"codex": codex, "claude": claude}[args.provider](root)


if __name__ == "__main__":
    main()
