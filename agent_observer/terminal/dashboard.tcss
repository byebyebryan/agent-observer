Screen { background: $surface; color: $text; }
#header { height: auto; padding: 0 1; background: $panel; color: $text; text-style: bold; }
#sources { height: auto; padding: 0 1; color: $text-muted; }
#toolbar { height: auto; display: none; padding: 0 1; color: $text-muted; }
#search { height: 1; min-height: 1; max-height: 1; display: none; border: none; padding: 0 1; }
#content { height: 1fr; padding: 0 1; overflow-y: auto; }
#status { height: auto; padding: 0 1; color: $text-muted; }
#footer { height: auto; padding: 0 1; background: $panel; color: $text-muted; }
.row { height: 1; }
.row.selected-row { background: $foreground 8%; text-style: bold; }
.table-heading { color: $text-muted; text-style: bold; }
.compact-row { height: 2; }
.compact-row.selected-row { background: $foreground 8%; }
.compact-row .row { background: transparent; }
.compact-row .compact-context { text-style: not bold; }
.compact-row.selected-row .compact-context { text-style: not bold; }
.cell { height: 1; padding: 0; margin: 0; overflow: hidden; text-wrap: nowrap; }
.selected-row .cell { text-style: bold; }
.selected-row .selection-marker { text-style: bold; }
.section-heading { height: 1; color: $text; text-style: bold; }
.detail-title { text-style: bold; }
.filter-tabs { color: $text; }
.filter-option { height: auto; width: 1fr; }
.source-evidence { color: $text-muted; }
#split-content { height: 1fr; }
#split-list { height: 1fr; }
#split-detail { height: 1fr; border-left: solid $panel; padding-left: 1; scrollbar-gutter: stable; }
#split-detail.details-focused { border-left: solid $primary; }
